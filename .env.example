# MapTiler API key for MapLibre journey maps (Base v4 style).
# Create a free key at https://cloud.maptiler.com/
PUBLIC_MAPTILER_API_KEY=

# Web3Forms access key for contact forms (/contact/ and /join-our-journey/#contact).
# 1. Go to https://web3forms.com/ and create an access key for blueheaven@sailboatadventure.dk
# 2. Confirm the verification email sent to that inbox
# 3. Paste the access key below (local dev) and in GitHub → Settings → Variables → PUBLIC_WEB3FORMS_ACCESS_KEY (production)
PUBLIC_WEB3FORMS_ACCESS_KEY=
