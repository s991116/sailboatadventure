---
import '../styles/global.css';

type Props = {
  title?: string;
};

const { title = 'Sailboat Adventure' } = Astro.props as Props;
---

<!doctype html>
<html lang="da">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
	</head>
	<body class="min-h-dvh bg-slate-950 text-slate-50 antialiased">
		<main class="mx-auto w-full max-w-3xl px-4 py-12">
			<slot />
		</main>
	</body>
</html>
