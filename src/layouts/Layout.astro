---
import '../styles/global.css';
import '../styles/typography.css';
import LanguageSwitch from '../components/LanguageSwitch.astro';
import { isActivePath, localePath, resolveLocale, t, type Locale } from '../i18n/locale';
import { ui } from '../i18n/messages';

type Props = {
	title?: string;
	locale?: Locale;
};

const pathname = Astro.url?.pathname ?? '/';
const locale = resolveLocale((Astro.props as Props).locale, pathname);
const { title = 'Sailboat Adventure' } = Astro.props as Props;

const navItems = [
	{ path: '/', label: ui.nav.home },
	{ path: '/plannedroute/', label: ui.nav.plannedRoute },
	{ path: '/join-our-journey/', label: ui.nav.join },
	{ path: '/history/', label: ui.nav.history },
	{ path: '/tips/', label: ui.nav.tips },
	{ path: '/about/', label: ui.nav.about },
] as const;

const alternateBase = Astro.site ?? Astro.url;
const daUrl = new URL(localePath('da', pathname), alternateBase).href;
const enUrl = new URL(localePath('en', pathname), alternateBase).href;
---

<!doctype html>
<html lang={locale}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<link rel="alternate" hreflang="da" href={daUrl} />
		<link rel="alternate" hreflang="en" href={enUrl} />
		<link rel="alternate" hreflang="x-default" href={enUrl} />
		<style is:inline>
			html.lang-pending { visibility: hidden; }
		</style>
		<script is:inline>
			(function () {
				var YEAR = 60 * 60 * 24 * 365;

				function cookieLang() {
					var match = document.cookie.match(/(?:^|; )lang=(da|en)(?:;|$)/);
					return match ? match[1] : null;
				}

				function setCookie(lang, persistent) {
					var cookie = 'lang=' + lang + '; Path=/; SameSite=Lax';
					if (persistent) cookie += '; Max-Age=' + YEAR;
					document.cookie = cookie;
				}

				function isDanishPath(path) {
					return path === '/da' || path.indexOf('/da/') === 0;
				}

				function barePath(path) {
					var value = path || '/';
					if (value === '/da' || value.indexOf('/da/') === 0) value = value.slice(3) || '/';
					if (value.charAt(0) !== '/') value = '/' + value;
					if (value.length > 1 && value.charAt(value.length - 1) !== '/') value += '/';
					return value;
				}

				function targetFor(lang, path) {
					var bare = barePath(path);
					var suffix = location.search + location.hash;
					if (lang === 'da') return (bare === '/' ? '/da/' : '/da' + bare) + suffix;
					return bare + suffix;
				}

				function needsMove(lang, path) {
					var danish = isDanishPath(path);
					return (lang === 'da' && !danish) || (lang === 'en' && danish);
				}

				function showPage() {
					document.documentElement.classList.remove('lang-pending');
				}

				function apply(lang) {
					var path = location.pathname || '/';
					if (!needsMove(lang, path)) {
						showPage();
						return;
					}
					location.replace(targetFor(lang, path));
				}

				document.addEventListener('click', function (event) {
					var node = event.target;
					if (!node || !node.closest) return;
					var link = node.closest('[data-set-lang]');
					if (!link) return;
					var lang = link.getAttribute('data-set-lang');
					if (lang === 'da' || lang === 'en') setCookie(lang, true);
				});

				var chosen = cookieLang();
				if (chosen) {
					apply(chosen);
					return;
				}

				if (isDanishPath(location.pathname || '/')) {
					setCookie('da', true);
					return;
				}

				document.documentElement.classList.add('lang-pending');
				var settled = false;
				function settle(lang, persistent) {
					if (settled) return;
					settled = true;
					setCookie(lang, persistent);
					apply(lang);
				}

				var timer = setTimeout(function () {
					settle('en', false);
				}, 1800);

				fetch('https://api.country.is/', { cache: 'no-store' })
					.then(function (response) {
						return response.json();
					})
					.then(function (data) {
						clearTimeout(timer);
						settle(data && data.country === 'DK' ? 'da' : 'en', true);
					})
					.catch(function () {
						clearTimeout(timer);
						settle('en', false);
					});
			})();
		</script>
		<link rel="icon" href="/favicon.ico" sizes="any" />
		<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
		<link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;500;600&family=Inter:wght@400;500;600&display=swap"
			rel="stylesheet"
		/>
		<script is:inline>
			(function () {
				var host = location.hostname;
				if (host === 'localhost' || host === '127.0.0.1' || host === '::1') return;
				if (host.slice(0, 4) === 'www.') host = host.slice(4);

				var sections = [
					{ href: '/', label: 'Home' },
					{ href: '/plannedroute/', label: 'Planned Route' },
					{ href: '/join-our-journey/', label: 'Join Our Journey' },
					{ href: '/history/', label: 'History' },
					{ href: '/tips/', label: 'Tips' },
					{ href: '/about/', label: 'About us' },
				];

				function trimSlash(value) {
					if (value.length > 1 && value.charAt(value.length - 1) === '/') return value.slice(0, -1);
					return value;
				}

				function barePath(value) {
					var path = value || '/';
					if (path === '/da' || path.indexOf('/da/') === 0) path = path.slice(3) || '/';
					return path;
				}

				var page = trimSlash(barePath(location.pathname || '/'));
				var section = null;
				for (var i = 0; i < sections.length; i++) {
					var href = trimSlash(sections[i].href);
					var underSection = href === '/' ? page === '/' : page === href || page.indexOf(href + '/') === 0;
					if (underSection) {
						section = sections[i];
						break;
					}
				}

				var countedPath = host + (section ? trimSlash(section.href) : page);
				window.goatcounter = {
					path: function () {
						return countedPath;
					},
					title: section ? section.label : document.title,
				};

				var script = document.createElement('script');
				script.async = true;
				script.src = 'https://gc.zgo.at/count.js';
				script.dataset.goatcounter = 'https://sailboatadventure.goatcounter.com/count';
				document.head.appendChild(script);
			})();
		</script>
	</head>
	<body class="min-h-dvh antialiased">
		<header class="site-header sticky top-0 z-50 backdrop-blur">
			<nav class="site-container relative flex flex-nowrap items-center gap-4 py-4" data-site-nav aria-label={t(locale, ui.nav.main)}>
				<div class="nav-links flex shrink-0 items-center gap-6" data-nav-links>
					{navItems.map((item) => {
						const href = localePath(locale, item.path);
						const isActive = isActivePath(pathname, href);
						return (
							<a
								href={href}
								aria-current={isActive ? 'page' : undefined}
								class="nav-link"
							>
								{t(locale, item.label)}
							</a>
						);
					})}
				</div>
				<div class="nav-tools" data-nav-tools>
					<button
						type="button"
						class="nav-menu-button"
						aria-expanded="false"
						aria-controls="mobile-nav-panel"
						aria-label={t(locale, ui.nav.openMenu)}
						data-label-open={t(locale, ui.nav.openMenu)}
						data-label-close={t(locale, ui.nav.closeMenu)}
					>
						<span class="nav-menu-button__bar" aria-hidden="true"></span>
						<span class="nav-menu-button__bar" aria-hidden="true"></span>
						<span class="nav-menu-button__bar" aria-hidden="true"></span>
					</button>
					<LanguageSwitch locale={locale} />
				</div>
			</nav>
			<div id="mobile-nav-panel" class="nav-panel hidden" hidden>
				<div class="site-container pb-4">
					{navItems.map((item) => {
						const href = localePath(locale, item.path);
						const isActive = isActivePath(pathname, href);
						return (
							<a
								href={href}
								aria-current={isActive ? 'page' : undefined}
								class="nav-panel__link"
							>
								{t(locale, item.label)}
							</a>
						);
					})}
				</div>
			</div>
		</header>
		<script is:inline>
			(function () {
				var header = document.querySelector('.site-header');
				var nav = document.querySelector('[data-site-nav]');
				var links = document.querySelector('[data-nav-links]');
				var menuButton = document.querySelector('.nav-menu-button');
				var mobilePanel = document.getElementById('mobile-nav-panel');
				if (!header || !nav || !links || !menuButton || !mobilePanel) return;

				function setMenuOpen(open) {
					menuButton.setAttribute('aria-expanded', open ? 'true' : 'false');
					menuButton.setAttribute(
						'aria-label',
						open ? menuButton.getAttribute('data-label-close') : menuButton.getAttribute('data-label-open'),
					);
					mobilePanel.hidden = !open;
					mobilePanel.classList.toggle('hidden', !open);
				}

				var tools = document.querySelector('[data-nav-tools]');
				var cachedLinksWidth = 0;

				function linksWidth() {
					var kids = links.children;
					var gap = parseFloat(getComputedStyle(links).columnGap) || 0;
					var total = 0;
					for (var i = 0; i < kids.length; i++) total += kids[i].offsetWidth;
					if (kids.length > 1) total += gap * (kids.length - 1);
					if (total > 0) cachedLinksWidth = total;
					return cachedLinksWidth;
				}

				function updateNav() {
					var navStyle = getComputedStyle(nav);
					var gap = parseFloat(navStyle.columnGap) || 0;
					var padding = (parseFloat(navStyle.paddingLeft) || 0) + (parseFloat(navStyle.paddingRight) || 0);
					var toolsWidth = tools ? tools.getBoundingClientRect().width : 0;
					var available = nav.clientWidth - padding - toolsWidth - (toolsWidth ? gap : 0);
					var needed = linksWidth();
					var collapsed = header.classList.contains('is-collapsed');
					// A few pixels of slack so the bar does not flicker at the boundary.
					var collapse = collapsed ? needed > available - 8 : needed > available + 1;
					if (collapsed === collapse) return;
					header.classList.toggle('is-collapsed', collapse);
					if (collapse) {
						links.setAttribute('inert', '');
						links.setAttribute('aria-hidden', 'true');
					} else {
						links.removeAttribute('inert');
						links.removeAttribute('aria-hidden');
						setMenuOpen(false);
					}
				}

				menuButton.addEventListener('click', function () {
					setMenuOpen(menuButton.getAttribute('aria-expanded') !== 'true');
				});

				var panelLinks = mobilePanel.querySelectorAll('a');
				for (var i = 0; i < panelLinks.length; i++) {
					panelLinks[i].addEventListener('click', function () {
						setMenuOpen(false);
					});
				}

				updateNav();
				if (window.ResizeObserver) {
					var observer = new ResizeObserver(updateNav);
					observer.observe(nav);
				} else {
					window.addEventListener('resize', updateNav);
				}
				if (document.fonts && document.fonts.ready) document.fonts.ready.then(updateNav);
			})();
		</script>

		<main class="site-container py-12 sm:py-16">
			<slot />
		</main>
	</body>
</html>

