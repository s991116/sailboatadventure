---
type Props = {
	code: 'dk' | 'gb';
	class?: string;
};

const { code, class: className } = Astro.props as Props;
---

<span class:list={['flag-icon', className]} aria-hidden="true">
	{
		code === 'dk' ? (
			<svg viewBox="0 0 37 28" xmlns="http://www.w3.org/2000/svg">
				<rect width="37" height="28" fill="#c8102e" />
				<rect x="12" width="4" height="28" fill="#fff" />
				<rect y="12" width="37" height="4" fill="#fff" />
			</svg>
		) : (
			<svg viewBox="0 0 60 30" xmlns="http://www.w3.org/2000/svg">
				<rect width="60" height="30" fill="#012169" />
				<path d="M0 0 L60 30 M60 0 L0 30" stroke="#fff" stroke-width="6" />
				<path d="M0 0 L60 30 M60 0 L0 30" stroke="#C8102E" stroke-width="2" />
				<path d="M30 0 V30 M0 15 H60" stroke="#fff" stroke-width="10" />
				<path d="M30 0 V30 M0 15 H60" stroke="#C8102E" stroke-width="6" />
			</svg>
		)
	}
</span>

<style>
	.flag-icon {
		display: inline-flex;
		width: 1.35rem;
		height: 0.95rem;
		overflow: hidden;
		border-radius: 2px;
		border: 1px solid var(--color-border);
		flex-shrink: 0;
		box-shadow: 0 1px 2px rgba(20, 20, 20, 0.08);
	}

	.flag-icon svg {
		width: 100%;
		height: 100%;
		display: block;
	}
</style>
