---
import FlagIcon from './FlagIcon.astro';
import { localePath, t, type Locale } from '../i18n/locale';
import { ui } from '../i18n/messages';

type Props = {
	locale: Locale;
};

const { locale } = Astro.props as Props;
const pathname = Astro.url.pathname;

const options = [
	{ locale: 'da' as const, href: localePath('da', pathname), label: 'Dansk', flag: 'dk' as const },
	{ locale: 'en' as const, href: localePath('en', pathname), label: 'English', flag: 'gb' as const },
];
---

<div class="lang-switch" data-lang-switch>
	<button
		type="button"
		class="lang-switch__button"
		aria-haspopup="listbox"
		aria-expanded="false"
		aria-label={t(locale, ui.nav.language)}
	>
		<FlagIcon code={locale === 'da' ? 'dk' : 'gb'} />
		<svg class="lang-switch__chevron" viewBox="0 0 12 8" aria-hidden="true">
			<path
				d="M1 1.5 L6 6.5 L11 1.5"
				fill="none"
				stroke="currentColor"
				stroke-width="1.5"
				stroke-linecap="round"
				stroke-linejoin="round"></path>
		</svg>
	</button>
	<ul class="lang-switch__menu" role="listbox" hidden>
		{
			options.map((option) => (
				<li>
					<a
						href={option.href}
						class:list={['lang-switch__option', { 'is-current': option.locale === locale }]}
						role="option"
						hreflang={option.locale}
						lang={option.locale}
						aria-selected={option.locale === locale}
						data-set-lang={option.locale}
					>
						<FlagIcon code={option.flag} />
						<span>{option.label}</span>
					</a>
				</li>
			))
		}
	</ul>
</div>

<script>
	for (const root of document.querySelectorAll<HTMLElement>('[data-lang-switch]')) {
		const button = root.querySelector<HTMLButtonElement>('.lang-switch__button');
		const menu = root.querySelector<HTMLElement>('.lang-switch__menu');
		if (!button || !menu) continue;

		const setOpen = (open: boolean) => {
			button.setAttribute('aria-expanded', open ? 'true' : 'false');
			menu.hidden = !open;
		};

		button.addEventListener('click', (event) => {
			event.stopPropagation();
			setOpen(menu.hidden);
		});

		document.addEventListener('click', (event) => {
			if (!root.contains(event.target as Node)) setOpen(false);
		});

		document.addEventListener('keydown', (event) => {
			if (event.key === 'Escape') setOpen(false);
		});
	}
</script>
