---
type Props = {
	formId: string;
	subject: string;
	stageOptions?: string[];
	stageLabel?: string;
	stagePlaceholder?: string;
};

const {
	formId,
	subject,
	stageOptions,
	stageLabel = 'Preferred passage',
	stagePlaceholder = 'Select a passage',
} = Astro.props as Props;

const web3formsAccessKey = import.meta.env.PUBLIC_WEB3FORMS_ACCESS_KEY ?? '';
const isConfigured = Boolean(web3formsAccessKey);

const labels = {
	name: 'Name',
	email: 'Email',
	message: 'Message',
	submit: 'Send message',
	success: 'Thanks for reaching out — we will reply soon.',
	error: 'Could not send your message. Please try again.',
	sending: 'Sending…',
};
---

<div class="max-w-xl">
	{
		isConfigured ? null : (
			<p class="mb-5 text-sm text-[color:var(--color-muted)]" role="status">
				Contact form is not configured yet. Add <code>PUBLIC_WEB3FORMS_ACCESS_KEY</code> from{' '}
				<a href="https://web3forms.com/" target="_blank" rel="noreferrer">
					web3forms.com
				</a>
				.
			</p>
		)
	}

	<form
		class="surface-card space-y-5 p-6 sm:p-8"
		method="POST"
		action="https://api.web3forms.com/submit"
		data-web3forms-contact-form={formId}
		novalidate
	>
		<input type="hidden" name="access_key" value={web3formsAccessKey} />
		<input type="hidden" name="subject" value={subject} />
		<input type="hidden" name="from_name" value="Sailboat Adventure" />
		<input type="checkbox" name="botcheck" class="sr-only" tabindex="-1" autocomplete="off" aria-hidden="true" />

		<div>
			<label for={`${formId}-name`} class="eyebrow text-[0.65rem]">{labels.name}</label>
			<input
				id={`${formId}-name`}
				name="name"
				type="text"
				required
				autocomplete="name"
				maxlength="120"
				class="mt-2 w-full rounded-xl border border-[color:var(--color-border)] bg-white px-4 py-3"
			/>
		</div>

		<div>
			<label for={`${formId}-email`} class="eyebrow text-[0.65rem]">{labels.email}</label>
			<input
				id={`${formId}-email`}
				name="email"
				type="email"
				required
				autocomplete="email"
				maxlength="200"
				class="mt-2 w-full rounded-xl border border-[color:var(--color-border)] bg-white px-4 py-3"
			/>
		</div>

		{
			stageOptions ? (
				<div>
					<label for={`${formId}-stage`} class="eyebrow text-[0.65rem]">
						{stageLabel}
					</label>
					<select
						id={`${formId}-stage`}
						name="stage"
						required
						class="mt-2 w-full rounded-xl border border-[color:var(--color-border)] bg-white px-4 py-3"
					>
						<option value="">{stagePlaceholder}</option>
						{stageOptions.map((option) => (
							<option value={option}>{option}</option>
						))}
					</select>
				</div>
			) : null
		}

		<div>
			<label for={`${formId}-message`} class="eyebrow text-[0.65rem]">{labels.message}</label>
			<textarea
				id={`${formId}-message`}
				name="message"
				required
				rows={5}
				maxlength="5000"
				class="mt-2 w-full resize-y rounded-xl border border-[color:var(--color-border)] bg-white px-4 py-3"
			></textarea>
		</div>

		<button
			type="submit"
			class="inline-flex items-center gap-2 font-medium disabled:cursor-not-allowed disabled:opacity-55"
			data-web3forms-contact-submit
			disabled={!isConfigured}
		>
			{labels.submit}
			<span aria-hidden="true">→</span>
		</button>

		<p class="hidden text-sm text-[color:var(--color-accent-strong)]" data-web3forms-contact-success role="status">
			{labels.success}
		</p>
		<p class="hidden text-sm text-red-800" data-web3forms-contact-error role="alert">
			{labels.error}
		</p>
	</form>
</div>

<script>
	for (const form of document.querySelectorAll<HTMLFormElement>('[data-web3forms-contact-form]')) {
		const success = form.querySelector<HTMLElement>('[data-web3forms-contact-success]');
		const error = form.querySelector<HTMLElement>('[data-web3forms-contact-error]');
		const submitBtn = form.querySelector<HTMLButtonElement>('[data-web3forms-contact-submit]');
		const defaultSubmitLabel = submitBtn?.innerHTML ?? '';
		const sendingLabel = 'Sending…';

		form.addEventListener('submit', async (event) => {
			event.preventDefault();

			const accessKey = new FormData(form).get('access_key');
			if (!accessKey || !submitBtn) return;

			success?.classList.add('hidden');
			error?.classList.add('hidden');
			submitBtn.disabled = true;
			submitBtn.textContent = sendingLabel;

			try {
				const response = await fetch(form.action, {
					method: 'POST',
					body: new FormData(form),
					headers: { Accept: 'application/json' },
				});
				const result = await response.json().catch(() => ({}));

				if (!response.ok || result.success === false) {
					throw new Error(result.message || 'Could not send your message.');
				}

				form.reset();
				success?.classList.remove('hidden');
			} catch {
				error?.classList.remove('hidden');
			} finally {
				submitBtn.disabled = false;
				submitBtn.innerHTML = defaultSubmitLabel;
			}
		});
	}
</script>
