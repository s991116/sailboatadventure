---
type Props = {
  channelId?: string;
  limit?: number;
  heading?: string;
  class?: string;
};

const {
  channelId = import.meta.env.PUBLIC_YOUTUBE_CHANNEL_ID,
  limit = 12,
  heading = 'Latest videos',
  class: className,
} = Astro.props as Props;

function decodeHtmlEntities(input: string) {
  return input.replace(/&(#x?[0-9a-fA-F]+|[a-zA-Z]+);/g, (full, entity) => {
    const name = String(entity);
    if (name[0] === '#') {
      const isHex = name[1]?.toLowerCase() === 'x';
      const raw = isHex ? name.slice(2) : name.slice(1);
      const codePoint = Number.parseInt(raw, isHex ? 16 : 10);
      if (!Number.isFinite(codePoint)) return full;
      try {
        return String.fromCodePoint(codePoint);
      } catch {
        return full;
      }
    }

    switch (name) {
      case 'amp':
        return '&';
      case 'lt':
        return '<';
      case 'gt':
        return '>';
      case 'quot':
        return '"';
      case 'apos':
        return "'";
      case 'nbsp':
        return ' ';
      default:
        return full;
    }
  });
}

type Video = {
  id: string;
  title: string;
  url: string;
  published: string;
  thumbnailUrl: string;
};

function parseIso8601DurationSeconds(duration: string): number | null {
  // YouTube uses ISO-8601 durations like "PT2M31S" / "PT1H4M" / "PT59S".
  // We also support days just in case ("P1DT2H").
  const match = /^P(?:(\d+)D)?T(?:(\d+)H)?(?:(\d+)M)?(?:(\d+)S)?$/.exec(duration);
  if (!match) return null;
  const days = Number.parseInt(match[1] ?? '0', 10);
  const hours = Number.parseInt(match[2] ?? '0', 10);
  const minutes = Number.parseInt(match[3] ?? '0', 10);
  const seconds = Number.parseInt(match[4] ?? '0', 10);
  if (![days, hours, minutes, seconds].every(Number.isFinite)) return null;
  return days * 86400 + hours * 3600 + minutes * 60 + seconds;
}

let videos: Video[] = [];
let errorMessage: string | null = null;

if (!channelId) {
  errorMessage = 'Missing YouTube channel id. Set PUBLIC_YOUTUBE_CHANNEL_ID or pass channelId.';
} else {
  try {
    const apiKey = import.meta.env.YOUTUBE_API_KEY;
    if (!apiKey) {
      throw new Error('Missing YOUTUBE_API_KEY. Set it in the build environment (GitHub Environment secret).');
    }

    // We may filter out Shorts after the initial fetch, so grab a buffer of candidates.
    const maxResults = Math.min(50, Math.max(1, Math.max(limit * 3, 25)));
    const apiUrl =
      'https://www.googleapis.com/youtube/v3/search' +
      `?part=snippet&channelId=${encodeURIComponent(channelId)}` +
      `&maxResults=${maxResults}` +
      `&order=date&type=video` +
      `&key=${encodeURIComponent(apiKey)}`;

    const res = await fetch(apiUrl, { headers: { accept: 'application/json' } });
    if (!res.ok) throw new Error(`YouTube API request failed (${res.status})`);

    const data = await res.json();
    const items = Array.isArray(data?.items) ? data.items : [];

    const candidates = items
      .map((item: any) => {
        const id = item?.id?.videoId;
        const snippet = item?.snippet;
        const rawTitle = String(snippet?.title ?? 'YouTube video');
        const title = decodeHtmlEntities(rawTitle);
        const published = snippet?.publishedAt ?? '';
        const url = id ? `https://www.youtube.com/watch?v=${id}` : '#';
        const thumbnailUrl =
          snippet?.thumbnails?.high?.url ??
          snippet?.thumbnails?.medium?.url ??
          snippet?.thumbnails?.default?.url ??
          '';

        if (!id || !thumbnailUrl) return null;
        return { id, title, published, url, thumbnailUrl } satisfies Video;
      })
      .filter(Boolean)
      .sort((a: Video, b: Video) => (b.published || '').localeCompare(a.published || ''));

    // Filter out Shorts (<= 3 minutes) using the videos.list endpoint for durations.
    let filtered = candidates;
    try {
      const ids = candidates.map((v) => v.id);
      if (ids.length) {
        const detailsUrl =
          'https://www.googleapis.com/youtube/v3/videos' +
          `?part=contentDetails&id=${encodeURIComponent(ids.join(','))}` +
          `&key=${encodeURIComponent(apiKey)}`;

        const detailsRes = await fetch(detailsUrl, { headers: { accept: 'application/json' } });
        if (detailsRes.ok) {
          const detailsData = await detailsRes.json();
          const detailsItems = Array.isArray(detailsData?.items) ? detailsData.items : [];
          const durationSecondsById = new Map<string, number>();
          for (const item of detailsItems) {
            const id = String(item?.id ?? '');
            const raw = String(item?.contentDetails?.duration ?? '');
            const seconds = parseIso8601DurationSeconds(raw);
            if (id && seconds != null) durationSecondsById.set(id, seconds);
          }

          filtered = candidates.filter((v) => {
            const seconds = durationSecondsById.get(v.id);
            // If duration is missing/unparseable, keep the item to avoid false negatives.
            if (seconds == null) return true;
            return seconds > 180;
          });
        }
      }
    } catch {
      // Ignore duration lookup errors; fall back to unfiltered candidates.
      filtered = candidates;
    }

    videos = filtered.slice(0, Math.max(1, limit));
  } catch (err) {
    errorMessage = err instanceof Error ? err.message : 'Failed to load YouTube videos.';
  }
}
---

<section class:list={["ytc", className].filter(Boolean)} aria-label={heading}>
  <div class="ytc__header">
    <h2 class="ytc__title">{heading}</h2>
    {channelId && (
      <a class="ytc__more" href={`https://www.youtube.com/channel/${channelId}`} target="_blank" rel="noreferrer">
        View channel
      </a>
    )}
  </div>

  {errorMessage ? (
    <p class="ytc__error">{errorMessage}</p>
  ) : (
    <div class="ytc__track" role="list" aria-label={`${heading} carousel`}>
      {videos.map((video) => (
        <a
          class="ytc__item"
          role="listitem"
          href={video.url}
          target="_blank"
          rel="noreferrer"
          aria-label={video.title}
          title={video.title}
        >
          <div class="ytc__thumb">
            <img
              class="ytc__img"
              src={video.thumbnailUrl}
              alt={video.title}
              width="320"
              height="180"
              loading="lazy"
              decoding="async"
            />
          </div>
          <span class="ytc__episodeTitle">
            <span class="ytc__episodeTitleText">{video.title}</span>
          </span>
        </a>
      ))}
    </div>
  )}
</section>

<style>
  .ytc__header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
  }

  .ytc__title {
    margin: 0;
    font-size: clamp(1.35rem, 2.2vw, 1.8rem);
  }

  .ytc__more {
    font-size: 0.95rem;
    color: var(--color-muted);
  }

  .ytc__more:hover {
    color: var(--color-text);
  }

  .ytc__error {
    margin-top: 0.75rem;
    color: var(--color-muted);
  }

  .ytc__track {
    margin-top: 1rem;
    display: flex;
    flex-wrap: nowrap;
    gap: 1.1rem;
    overflow-x: auto;
    padding: 0.25rem 0.25rem 0.75rem;
    scroll-snap-type: x mandatory;
    -webkit-overflow-scrolling: touch;
  }

  .ytc__item {
    flex: 0 0 auto;
    width: 220px;
    border: 10px solid #ffffff;
    border-radius: 18px;
    box-shadow: 0 14px 30px rgba(20, 20, 20, 0.12);
    background: #ffffff;
    overflow: hidden;
    scroll-snap-align: start;
    display: flex;
    flex-direction: column;
    text-decoration: none;
    color: inherit;
  }

  .ytc__item:focus-visible {
    outline: 3px solid rgba(184, 132, 58, 0.55);
    outline-offset: 4px;
  }

  .ytc__thumb {
    width: 100%;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    flex: 0 0 auto;
  }

  .ytc__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .ytc__episodeTitle {
    padding: 0.6rem 0.75rem 0.75rem;
    font-size: 0.95rem;
    line-height: 1.25;
    color: var(--color-text);
  }

  .ytc__episodeTitleText {
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    overflow: hidden;
    text-overflow: ellipsis;
    max-height: calc(1.25em * 2);
  }

  @media (min-width: 640px) {
    .ytc__item {
      width: 260px;
    }
  }
</style>
