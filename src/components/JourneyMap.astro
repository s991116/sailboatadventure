---
import type { JourneyLeg } from '../data/journey-legs';
import 'maplibre-gl/dist/maplibre-gl.css';

type Props = {
	legs: JourneyLeg[];
};

const { legs } = Astro.props as Props;
const mapTilerKey = import.meta.env.PUBLIC_MAPTILER_API_KEY ?? '';
const mapId = `journey-map-${Math.random().toString(36).slice(2, 9)}`;
const mapConfig = JSON.stringify({ legs, mapTilerKey });
---

<div class="journey-map-wrap" data-journey-map-wrap>
	<div class="journey-map-frame">
		<div id={mapId} class="journey-map" data-journey-map data-map-config={mapConfig}></div>
		<div class="journey-map__overlays" data-journey-map-overlays hidden>
			<p class="journey-map__passage-label" data-journey-map-passage></p>
			<button type="button" class="journey-map__full-route" data-journey-back>
				Full route
			</button>
		</div>
	</div>
	{!mapTilerKey ? (
		<p class="journey-map__notice">
			Map preview requires a MapTiler API key. Set <code>PUBLIC_MAPTILER_API_KEY</code> in your environment.
		</p>
	) : null}
</div>

<script>
	import maplibregl from 'maplibre-gl';

	type MapStop = {
		name: string;
		coordinates: [number, number];
		role: 'start' | 'stop' | 'end';
	};

	type MapLeg = {
		slug: string;
		number: number;
		title: string;
		routeLabel: string;
		color: string;
		route: [number, number][];
		stops: MapStop[];
	};

	type MapConfig = {
		legs: MapLeg[];
		mapTilerKey: string;
	};

	const initJourneyMap = (container: HTMLElement) => {
		const raw = container.dataset.mapConfig;
		if (!raw) return;

		const config = JSON.parse(raw) as MapConfig;
		if (!config.mapTilerKey) return;

		const { legs } = config;
		const sourceId = 'journey-routes';
		const layerPrefix = 'journey-leg';

		const features = legs.map((leg) => ({
			type: 'Feature',
			properties: {
				slug: leg.slug,
				title: leg.title,
				routeLabel: leg.routeLabel,
				color: leg.color,
				number: leg.number,
			},
			geometry: {
				type: 'LineString',
				coordinates: leg.route,
			},
		}));

		const formatPlaceName = (name: string) => name.replace(/,\s*Danmark$/i, '').trim();

		const getLegTooltip = (leg: MapLeg) => {
			const start = leg.stops.find((stop) => stop.role === 'start') ?? leg.stops[0];
			const end = leg.stops.find((stop) => stop.role === 'end') ?? leg.stops[leg.stops.length - 1];
			return `${formatPlaceName(start.name)} to ${formatPlaceName(end.name)}`;
		};

		const map = new maplibregl.Map({
			container,
			style: `https://api.maptiler.com/maps/base-v4/style.json?key=${config.mapTilerKey}`,
			center: [-10, 48],
			zoom: 3.2,
			attributionControl: false,
			dragPan: false,
			dragRotate: false,
			scrollZoom: false,
			boxZoom: false,
			doubleClickZoom: false,
			touchZoomRotate: false,
			touchPitch: false,
			keyboard: false,
		});

		map.addControl(
			new maplibregl.AttributionControl({
				customAttribution: '© MapTiler © OpenStreetMap contributors',
			}),
			'bottom-left',
		);

		const tooltip = new maplibregl.Popup({
			closeButton: false,
			closeOnClick: false,
			offset: 12,
			className: 'journey-map-tooltip',
			maxWidth: '240px',
		});

		let selectedSlug: string | null = null;

		const fitToSlug = (slug: string, animate = true) => {
			const leg = legs.find((item) => item.slug === slug);
			if (!leg) return;

			const lngs = leg.route.map((coord) => coord[0]);
			const lats = leg.route.map((coord) => coord[1]);

			map.fitBounds(
				[
					[Math.min(...lngs), Math.min(...lats)],
					[Math.max(...lngs), Math.max(...lats)],
				],
				{
					padding: { top: 48, right: 48, bottom: 48, left: 48 },
					duration: animate ? 900 : 0,
					maxZoom: 7.5,
				},
			);
		};

		const fitAllLegs = (animate = true) => {
			const allCoords = legs.flatMap((leg) => leg.route);
			const lngs = allCoords.map((coord) => coord[0]);
			const lats = allCoords.map((coord) => coord[1]);

			map.fitBounds(
				[
					[Math.min(...lngs), Math.min(...lats)],
					[Math.max(...lngs), Math.max(...lats)],
				],
				{
					padding: { top: 40, right: 40, bottom: 40, left: 40 },
					duration: animate ? 900 : 0,
				},
			);
		};

		const refitMap = () => {
			map.resize();
			if (selectedSlug) {
				fitToSlug(selectedSlug, false);
			} else {
				fitAllLegs(false);
			}
		};

		const wrap = container.closest<HTMLElement>('[data-journey-map-wrap]');
		const overlays = wrap?.querySelector<HTMLElement>('[data-journey-map-overlays]');
		const passageLabel = wrap?.querySelector<HTMLElement>('[data-journey-map-passage]');

		const setMapCompact = (compact: boolean) => {
			container.classList.toggle('is-compact', compact);
			requestAnimationFrame(() => {
				map.resize();
			});
		};

		const setOverlays = (slug: string | null) => {
			if (!overlays || !passageLabel) return;

			if (!slug) {
				overlays.hidden = true;
				passageLabel.textContent = '';
				return;
			}

			const leg = legs.find((item) => item.slug === slug);
			passageLabel.textContent = leg ? `Passage ${leg.number}` : '';
			overlays.hidden = !leg;
		};

		const setActiveLeg = (slug: string | null) => {
			for (const leg of legs) {
				const isActive = slug ? leg.slug === slug : true;
				const lineOpacity = slug ? (isActive ? 0.95 : 0.6) : 0.9;
				const lineWidth = slug && isActive ? 5 : 3;

				if (map.getLayer(`${layerPrefix}-${leg.slug}-line`)) {
					map.setPaintProperty(`${layerPrefix}-${leg.slug}-line`, 'line-opacity', lineOpacity);
					map.setPaintProperty(`${layerPrefix}-${leg.slug}-line`, 'line-width', lineWidth);
				}
				if (map.getLayer(`${layerPrefix}-${leg.slug}-halo`)) {
					map.setPaintProperty(`${layerPrefix}-${leg.slug}-halo`, 'line-opacity', slug && isActive ? 0.28 : 0.08);
				}
			}
		};

		const selectLeg = (slug: string, animate = true) => {
			selectedSlug = slug;
			setMapCompact(true);
			setActiveLeg(slug);
			setOverlays(slug);
			fitToSlug(slug, animate);
			tooltip.remove();
			window.dispatchEvent(new CustomEvent('journey-leg-select', { detail: { slug } }));
		};

		map.on('error', (event) => {
			console.error('Journey map failed to load:', event.error ?? event);
		});

		map.on('load', () => {
			map.addSource(sourceId, {
				type: 'geojson',
				data: {
					type: 'FeatureCollection',
					features,
				},
			});

			for (const leg of legs) {
				const filter: maplibregl.FilterSpecification = ['==', ['get', 'slug'], leg.slug];

				map.addLayer({
					id: `${layerPrefix}-${leg.slug}-halo`,
					type: 'line',
					source: sourceId,
					filter,
					layout: {
						'line-cap': 'round',
						'line-join': 'round',
					},
					paint: {
						'line-color': leg.color,
						'line-width': 10,
						'line-opacity': 0.1,
					},
				});

				map.addLayer({
					id: `${layerPrefix}-${leg.slug}-line`,
					type: 'line',
					source: sourceId,
					filter,
					layout: {
						'line-cap': 'round',
						'line-join': 'round',
					},
					paint: {
						'line-color': leg.color,
						'line-width': 3,
						'line-opacity': 0.9,
					},
				});

				map.addLayer({
					id: `${layerPrefix}-${leg.slug}-hit`,
					type: 'line',
					source: sourceId,
					filter,
					layout: {
						'line-cap': 'round',
						'line-join': 'round',
					},
					paint: {
						'line-color': leg.color,
						'line-width': 22,
						'line-opacity': 0,
					},
				});
			}

			for (const leg of legs) {
				for (const layerSuffix of ['line', 'halo', 'hit']) {
					const layerId = `${layerPrefix}-${leg.slug}-${layerSuffix}`;

					map.on('mouseenter', layerId, (event) => {
						map.getCanvas().style.cursor = 'pointer';
						tooltip
							.setLngLat(event.lngLat)
							.setHTML(`<span class="journey-map-tooltip__text">${getLegTooltip(leg)}</span>`)
							.addTo(map);
					});

					map.on('mousemove', layerId, (event) => {
						tooltip.setLngLat(event.lngLat);
					});

					map.on('mouseleave', layerId, () => {
						map.getCanvas().style.cursor = '';
						tooltip.remove();
					});

					map.on('click', layerId, () => {
						selectLeg(leg.slug);
					});
				}
			}

			fitAllLegs(false);

			const hashSlug = window.location.hash.replace(/^#/, '');
			if (hashSlug && legs.some((leg) => leg.slug === hashSlug)) {
				selectLeg(hashSlug, false);
			}

			window.addEventListener('journey-leg-select', ((event: CustomEvent<{ slug: string }>) => {
				const { slug } = event.detail;
				if (slug === selectedSlug) return;
				selectedSlug = slug;
				setMapCompact(true);
				setActiveLeg(slug);
				setOverlays(slug);
				fitToSlug(slug, true);
			}) as EventListener);

			window.addEventListener('journey-leg-clear', () => {
				if (!selectedSlug) return;
				selectedSlug = null;
				setMapCompact(false);
				setActiveLeg(null);
				setOverlays(null);
				fitAllLegs(true);
			});

			const resizeObserver =
				typeof ResizeObserver !== 'undefined'
					? new ResizeObserver(() => {
							refitMap();
						})
					: null;
			resizeObserver?.observe(container);
			window.addEventListener('resize', refitMap);
		});

		return map;
	};

	const containers = document.querySelectorAll<HTMLElement>('[data-journey-map]');
	for (const container of containers) {
		initJourneyMap(container);
	}
</script>

<style>
	.journey-map-wrap {
		position: relative;
		width: 100%;
	}

	.journey-map-frame {
		position: relative;
	}

	.journey-map {
		width: 100%;
		aspect-ratio: 16 / 9;
		border-radius: 1rem;
		overflow: hidden;
		border: 1px solid var(--color-border);
		background: #e8edf2;
	}

	.journey-map.is-compact {
		/* 60% of the default 16/9 height */
		aspect-ratio: 16 / 5.4;
	}

	.journey-map__overlays {
		pointer-events: none;
		position: absolute;
		inset: 0;
		z-index: 2;
		display: flex;
		align-items: flex-start;
		justify-content: space-between;
		gap: 10px;
		padding: 10px;
		border-radius: 1rem;
	}

	.journey-map__overlays[hidden] {
		display: none;
	}

	.journey-map__passage-label,
	.journey-map__full-route {
		margin: 0;
		padding: 0.35rem 0.55rem;
		border-radius: 0.5rem;
		border: 1px solid var(--color-border);
		background: rgba(251, 247, 239, 0.94);
		box-shadow: 0 6px 14px rgba(20, 20, 20, 0.1);
		font-size: 0.75rem;
		font-weight: 600;
		letter-spacing: 0.22em;
		line-height: 1.25;
		text-transform: uppercase;
	}

	.journey-map__passage-label {
		color: var(--color-text);
	}

	.journey-map__full-route {
		pointer-events: auto;
		appearance: none;
		flex-shrink: 0;
		color: var(--color-accent-strong);
		cursor: pointer;
		text-decoration: underline;
		text-underline-offset: 0.18em;
	}

	.journey-map__full-route:hover {
		color: var(--color-accent);
	}

	.journey-map :global(.maplibregl-canvas) {
		cursor: default;
	}

	.journey-map :global(.journey-map-tooltip .maplibregl-popup-content) {
		padding: 0.4rem 0.7rem;
		border-radius: 999px;
		border: 1px solid var(--color-border);
		background: rgba(251, 247, 239, 0.96);
		box-shadow: 0 8px 18px rgba(20, 20, 20, 0.12);
		font-family: Inter, ui-sans-serif, system-ui, sans-serif;
		font-size: 0.72rem;
		font-weight: 500;
		line-height: 1.25;
		color: var(--color-text);
	}

	.journey-map :global(.journey-map-tooltip .maplibregl-popup-tip) {
		display: none;
	}

	.journey-map__notice {
		margin-top: 0.75rem;
		font-size: 0.875rem;
		color: var(--color-muted);
	}
</style>
