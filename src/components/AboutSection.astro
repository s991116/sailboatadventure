---
import OptimizedPhoto from './OptimizedPhoto.astro';
import ContactForm from './ContactForm.astro';
import { t, type Locale } from '../i18n/locale';
import { ui } from '../i18n/messages';
import type { ImageMetadata } from 'astro';
import louisePhoto from '../assets/photos/home/louise-on-deck.png';
import philipPhoto from '../assets/photos/join-our-journey/philip_beanie.jpg';
import couplePhoto from '../assets/photos/join-our-journey/louise-philip-sailboat.jpg';
import blueHeavenPhoto from '../assets/photos/join-our-journey/Sailboat_cliff.jpg';

type Props = { locale: Locale };
const { locale } = Astro.props;

const formLabels = {
	name: t(locale, ui.form.name),
	email: t(locale, ui.form.email),
	message: t(locale, ui.form.message),
	submit: t(locale, ui.form.submit),
	success: t(locale, ui.form.success),
	error: t(locale, ui.form.error),
	sending: t(locale, ui.form.sending),
};

const portraits: {
	src: ImageMetadata;
	alt: string;
	title: string;
	panX: string;
	position: string;
	layout: 'banner' | 'image-start' | 'image-end';
	paragraphs: string[];
}[] = [
	{
		src: couplePhoto,
		alt: t(locale, ui.about.coupleAlt),
		title: t(locale, ui.about.coupleTitle),
		panX: '50%',
		position: '50% calc(30% - 20px)',
		layout: 'banner',
		paragraphs: ui.about.intro.map((paragraph) => t(locale, paragraph)),
	},
	{
		src: philipPhoto,
		alt: t(locale, ui.about.philipAlt),
		title: 'Philip',
		panX: '55%',
		position: '55% 42%',
		layout: 'image-start',
		paragraphs: ui.about.philip.map((paragraph) => t(locale, paragraph)),
	},
	{
		src: louisePhoto,
		alt: t(locale, ui.about.louiseAlt),
		title: 'Louise',
		panX: '42%',
		position: '36% 48%',
		layout: 'image-end',
		paragraphs: ui.about.louise.map((paragraph) => t(locale, paragraph)),
	},
	{
		src: blueHeavenPhoto,
		alt: t(locale, ui.about.boatAlt),
		title: t(locale, ui.about.boatTitle),
		panX: '50%',
		position: '50% calc(30% - 20px)',
		layout: 'banner',
		paragraphs: ui.about.boat.map((paragraph) => t(locale, paragraph)),
	},
];
---

<section id="about" class="home-about py-6 sm:py-10">
	{
		portraits.map((portrait, index) =>
			portrait.layout === 'banner' ? (
				<div>
					<div class:list={['home-bleed', index === 0 ? null : 'mt-10']} data-home-pan data-pan-x={portrait.panX}>
						<OptimizedPhoto
							src={portrait.src}
							alt={portrait.alt}
							preset="center"
							aspectRatio="35/11"
							position={portrait.position}
							plain
							sizes="100vw"
						/>
						<h2 class="home-photo-title home-photo-title--light display-title">{portrait.title}</h2>
					</div>
					{index === 0 && <div class="accent-rule mt-6"></div>}
					<div class="page-prose mt-6">
						{portrait.paragraphs.map((paragraph) => (
							<p>{paragraph}</p>
						))}
					</div>
				</div>
			) : (
				<div class:list={['about-portrait', portrait.layout === 'image-end' && 'about-portrait--end']}>
					<div class:list={['page-prose about-portrait__title', portrait.layout === 'image-end' && 'about-portrait__title--side']}>
						<h2>{portrait.title}</h2>
					</div>
					<div class="about-portrait__photo">
						<OptimizedPhoto
							src={portrait.src}
							alt={portrait.alt}
							preset="center"
							aspectRatio="4/3"
							position={portrait.position}
							sizes="(min-width: 40rem) 22rem, calc(100vw - 4rem)"
						/>
					</div>
					<div class="page-prose about-portrait__copy">
						{portrait.paragraphs.map((paragraph) => (
							<p>{paragraph}</p>
						))}
					</div>
				</div>
			),
		)
	}

	<div class="page-prose mt-10">
		<h2 id="contact">{t(locale, ui.about.contactTitle)}</h2>
		<p>{t(locale, ui.about.contactBody)}</p>
	</div>

	<div class="mt-10">
		<ContactForm
			formId="about-contact"
			subject={t(locale, ui.about.contactSubject)}
			labels={formLabels}
		/>
	</div>
</section>

<style>
	.about-portrait {
		display: grid;
		align-items: start;
		gap: 1.25rem;
		margin-top: 2.5rem;
	}

	.about-portrait__photo {
		padding: 0 0.85rem 0.85rem;
	}

	.about-portrait__title {
		grid-column: 1 / -1;
	}

	.about-portrait__title--side {
		grid-column: 1;
	}

	@media (min-width: 640px) {
		.about-portrait {
			grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
			gap: 1.5rem 1.25rem;
		}

		.about-portrait--end {
			grid-template-columns: minmax(0, 6fr) minmax(0, 5fr);
		}

		.about-portrait--end .about-portrait__copy {
			grid-column: 1;
			grid-row: 2;
		}

		.about-portrait--end .about-portrait__photo {
			grid-column: 2;
			grid-row: 2;
		}
	}
</style>
