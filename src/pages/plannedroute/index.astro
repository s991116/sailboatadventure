---
import Layout from '../../layouts/Layout.astro';
import JourneyMap from '../../components/JourneyMap.astro';
import OptimizedPhoto from '../../components/OptimizedPhoto.astro';
import { getCollection } from 'astro:content';
import { journeyLegs } from '../../data/journey-legs';
import { formatGuestDateRange, joinOurJourneyContactHref } from '../../data/planned-passages';
import { resolveLocale, t, type Locale } from '../../i18n/locale';
import { ui } from '../../i18n/messages';
import { placeName } from '../../i18n/places';

type LocaleProps = { locale?: Locale };
const locale = resolveLocale((Astro.props as LocaleProps).locale, Astro.url.pathname);
const contactHref = joinOurJourneyContactHref(locale);

const legs = await getCollection('journey', ({ data }) => !data.draft);
const sortedLegs = legs.sort((a, b) => a.data.legNumber - b.data.legNumber);

const legPanels = sortedLegs.map((leg) => ({ leg }));

const guestBySlug = Object.fromEntries(
	journeyLegs.map((leg) => [
		leg.slug,
		leg.guestSignup.status === 'open'
			? {
					status: 'open' as const,
					dateRange: formatGuestDateRange(leg.guestSignup.startDate, leg.guestSignup.endDate, locale),
					href: contactHref,
				}
			: { status: 'fully-booked' as const },
	]),
);

const periodBySlug = Object.fromEntries(
	sortedLegs.map((leg) => {
		const periodFact = leg.data.facts.find((fact) => fact.label.en === 'Planned period');
		const period = periodFact ? t(locale, periodFact.value) : '';
		return [leg.slug, period];
	}),
);

const mobilePassages = journeyLegs.map((leg) => {
	const start = placeName(locale, leg.stops.find((stop) => stop.role === 'start')?.name ?? '');
	const end = placeName(locale, leg.stops.find((stop) => stop.role === 'end')?.name ?? '');
	return {
		slug: leg.slug,
		from: start,
		to: end,
		period: periodBySlug[leg.slug] ?? '',
		color: leg.color,
		guest: guestBySlug[leg.slug],
	};
});
---

<Layout locale={locale} title={t(locale, ui.route.title)}>
	<div class="journey-page" data-journey-page>
		<section class="journey-intro" data-journey-intro>
			<h1 class="display-title">{t(locale, ui.route.title)}</h1>
			<div class="accent-rule mt-6"></div>
			<p class="lede journey-intro__map-hint">{t(locale, ui.route.mapHint)}</p>
			<p class="lede journey-intro__list-hint">{t(locale, ui.route.listHint)}</p>
		</section>

		{
			legPanels.map(({ leg }) => (
				<header class="journey-passage-title hidden" data-journey-passage-title data-leg={leg.slug}>
					<button type="button" class="journey-mobile-back" data-journey-back>
						{t(locale, ui.route.fullRoute)}
					</button>
					<h1 class="display-title mt-4">{t(locale, leg.data.title)}</h1>
					<div class="accent-rule mt-6"></div>
				</header>
			))
		}

		<div class="journey-breakout" data-journey-map-breakout>
			<JourneyMap legs={journeyLegs} locale={locale} />
		</div>

		<nav class="journey-passage-list mt-8" data-journey-passage-list aria-label={t(locale, ui.route.passagesLabel)}>
			<ul class="journey-passage-list__items">
				{mobilePassages.map((passage) => (
					<li class="journey-passage-list__row">
						<button
							type="button"
							class="journey-passage-list__item"
							data-journey-passage-link
							data-leg={passage.slug}
						>
							<span
								class="journey-passage-list__swatch"
								style={`background:${passage.color}`}
								aria-hidden="true"
							/>
							<span class="journey-passage-list__text">
								<span class="journey-passage-list__route">
									{passage.from} → {passage.to}
								</span>
								<span class="journey-passage-list__meta">
									{passage.period ? <span>{passage.period}</span> : null}
									<span class="journey-passage-list__sep" aria-hidden="true"></span>
									<span>
										{passage.guest?.status === 'open' ? t(locale, ui.route.openToJoin) : t(locale, ui.route.fullyBooked)}
									</span>
								</span>
							</span>
						</button>
					</li>
				))}
			</ul>
		</nav>

		<p class="lede mt-8 sm:mt-10" data-journey-join-cta>
			{t(locale, ui.route.joinCta)}
			<a href={contactHref} class="text-link">
				{t(locale, ui.route.joinLink)}
				<span aria-hidden="true">→</span>
			</a>
		</p>

		<div class="journey-panels mt-10 sm:mt-12">
			{legPanels.map(({ leg }) => {
				return (
					<article class="journey-panel hidden space-y-8" data-journey-panel data-leg={leg.slug}>
						{(leg.data.facts.length > 0 || guestBySlug[leg.slug]) ? (
							<dl class="passage-facts">
								{leg.data.facts.map((fact) => (
									<div class="passage-fact">
										<dt class="eyebrow">{t(locale, fact.label)}</dt>
										<dd>{t(locale, fact.value)}</dd>
									</div>
								))}
								{(() => {
									const guest = guestBySlug[leg.slug];
									if (!guest) return null;
									return (
										<div class="passage-fact">
											<dt class="eyebrow">{t(locale, ui.route.guestCrew)}</dt>
											<dd>
												{guest.status === 'open' ? (
													<a href={guest.href} class="text-link">
														{t(locale, ui.route.joinPassage)}
														<span aria-hidden="true">→</span>
													</a>
												) : (
													t(locale, ui.route.fullyBooked)
												)}
											</dd>
										</div>
									);
								})()}
							</dl>
						) : null}

						{leg.data.gallery.length > 0 ? (
							<div class="passage-gallery">
								{leg.data.gallery.map((photo) => (
									<OptimizedPhoto src={photo.src} alt={t(locale, photo.alt)} aspectRatio="4/3" />
								))}
							</div>
						) : null}

						{(leg.data.sectionHeading || leg.data.intro) ? (
							<div class="passage-intro">
								{leg.data.sectionHeading ? (
									<h2 class="section-title">{t(locale, leg.data.sectionHeading)}</h2>
								) : null}
								{leg.data.sectionHeading ? <div class="accent-rule mt-6"></div> : null}
								{leg.data.intro ? (
									<p class="body mt-5">{t(locale, leg.data.intro)}</p>
								) : null}
							</div>
						) : null}

						{leg.data.highlights.length > 0 ? (
							<section class="passage-section space-y-3">
								<p class="eyebrow">{t(locale, ui.route.hope)}</p>
								<ul class="passage-highlights body list-disc space-y-2 pl-5">
									{leg.data.highlights.map((item) => (
										<li>{t(locale, item)}</li>
									))}
								</ul>
							</section>
						) : null}

						{leg.data.secondaryGallery.length > 0 ? (
							<div class="passage-gallery">
								{leg.data.secondaryGallery.map((photo) => (
									<OptimizedPhoto src={photo.src} alt={t(locale, photo.alt)} aspectRatio="4/3" />
								))}
							</div>
						) : null}

						{(leg.data.outroHeading || leg.data.outro) ? (
							<div class="passage-intro">
								{leg.data.outroHeading ? (
									<h2 class="section-title">{t(locale, leg.data.outroHeading)}</h2>
								) : null}
								{leg.data.outroHeading ? <div class="accent-rule mt-6"></div> : null}
								{leg.data.outro ? (
									<p class="body mt-5">{t(locale, leg.data.outro)}</p>
								) : null}
							</div>
						) : null}

						{leg.data.alternativeRoute ? (
							<section class="passage-section space-y-3">
								<p class="eyebrow">{t(locale, ui.route.alternative)}</p>
								<p class="body">{t(locale, leg.data.alternativeRoute)}</p>
							</section>
						) : null}

						{leg.data.closing ? (
							<div class="page-prose">
								<p>{t(locale, leg.data.closing)}</p>
							</div>
						) : null}
					</article>
				);
			})}
		</div>
	</div>
</Layout>

<script>
	const page = document.querySelector<HTMLElement>('[data-journey-page]');
	const intro = document.querySelector('[data-journey-intro]');
	const joinCta = document.querySelector<HTMLElement>('[data-journey-join-cta]');
	const passageList = document.querySelector<HTMLElement>('[data-journey-passage-list]');
	const titles = Array.from(document.querySelectorAll<HTMLElement>('[data-journey-passage-title]'));
	const panels = Array.from(document.querySelectorAll<HTMLElement>('[data-journey-panel]'));
	const mapEl = document.querySelector<HTMLElement>('[data-journey-map]');

	const showLeg = (slug: string) => {
		page?.classList.add('is-passage-view');
		intro?.classList.add('hidden');
		joinCta?.classList.add('hidden');
		passageList?.classList.add('hidden');
		for (const title of titles) {
			title.classList.toggle('hidden', title.dataset.leg !== slug);
		}
		for (const panel of panels) {
			panel.classList.toggle('hidden', panel.dataset.leg !== slug);
		}
		mapEl?.classList.add('is-compact');
		history.replaceState(null, '', `#${slug}`);
		window.scrollTo({ top: 0, left: 0, behavior: 'auto' });
	};

	const showIntro = () => {
		page?.classList.remove('is-passage-view');
		intro?.classList.remove('hidden');
		joinCta?.classList.remove('hidden');
		passageList?.classList.remove('hidden');
		for (const title of titles) {
			title.classList.add('hidden');
		}
		for (const panel of panels) {
			panel.classList.add('hidden');
		}
		mapEl?.classList.remove('is-compact');
		history.replaceState(null, '', window.location.pathname);
		window.scrollTo({ top: 0, left: 0, behavior: 'auto' });
	};

	window.addEventListener('journey-leg-select', ((event: CustomEvent<{ slug: string }>) => {
		showLeg(event.detail.slug);
	}) as EventListener);

	window.addEventListener('journey-leg-clear', () => {
		showIntro();
	});

	for (const button of document.querySelectorAll('[data-journey-back]')) {
		button.addEventListener('click', () => {
			window.dispatchEvent(new CustomEvent('journey-leg-clear'));
		});
	}

	for (const button of document.querySelectorAll<HTMLElement>('[data-journey-passage-link]')) {
		button.addEventListener('click', () => {
			const slug = button.dataset.leg;
			if (!slug) return;
			window.dispatchEvent(new CustomEvent('journey-leg-select', { detail: { slug } }));
		});
	}

	const hashSlug = window.location.hash.replace(/^#/, '');
	if (hashSlug && panels.some((panel) => panel.dataset.leg === hashSlug)) {
		showLeg(hashSlug);
	}
</script>

<style>
	.journey-intro,
	.journey-passage-title {
		margin-bottom: 1.5rem;
	}

	@media (min-width: 640px) {
		.journey-intro,
		.journey-passage-title {
			margin-bottom: 2rem;
		}
	}

	.journey-breakout {
		position: relative;
		left: 50%;
		right: 50%;
		margin-left: -50vw;
		margin-right: -50vw;
		width: 100vw;
		padding-inline: max(1.25rem, calc((100vw - 64rem) / 2 + 1.25rem));
	}

	.journey-intro__list-hint {
		display: none;
	}

	.journey-passage-list {
		display: block;
	}

	.journey-passage-list.hidden,
	.journey-page.is-passage-view .journey-passage-list {
		display: none;
	}

	.journey-mobile-back {
		display: none;
		appearance: none;
		border: 0;
		background: transparent;
		padding: 0;
		font: inherit;
		font-weight: 500;
		color: var(--color-accent-strong);
		cursor: pointer;
		text-align: left;
	}

	.journey-mobile-back:hover {
		color: var(--color-accent);
	}

	@media (max-width: 48rem) and (orientation: portrait) {
		.journey-breakout {
			display: none;
		}

		.journey-intro__map-hint {
			display: none;
		}

		.journey-intro__list-hint {
			display: block;
		}

		.journey-mobile-back {
			display: inline-flex;
		}
	}

	.journey-passage-list__items {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		gap: 0.65rem;
	}

	.journey-passage-list__row {
		display: block;
	}

	.journey-passage-list__item {
		appearance: none;
		border: 1px solid var(--color-border);
		background: var(--color-surface);
		border-radius: 1rem;
		padding: 0.9rem 1rem;
		display: flex;
		align-items: flex-start;
		gap: 0.75rem;
		width: 100%;
		text-align: left;
		cursor: pointer;
		color: inherit;
	}

	.journey-passage-list__item:hover {
		border-color: rgba(184, 132, 58, 0.45);
	}

	.journey-passage-list__swatch {
		width: 0.75rem;
		height: 0.75rem;
		border-radius: 999px;
		margin-top: 0.35rem;
		flex-shrink: 0;
	}

	.journey-passage-list__text {
		display: grid;
		gap: 0.25rem;
		min-width: 0;
	}

	.journey-passage-list__route {
		font-weight: 600;
		line-height: 1.35;
	}

	.journey-passage-list__meta {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.45rem;
		font-size: 0.9rem;
		color: var(--color-muted);
	}

	.journey-passage-list__sep {
		width: 1px;
		height: 0.9em;
		flex-shrink: 0;
		background: currentColor;
		opacity: 0.45;
	}

	.passage-facts {
		display: grid;
		gap: 1.25rem;
		padding: 1.25rem 0;
		border-top: 1px solid var(--color-border);
		border-bottom: 1px solid var(--color-border);
	}

	@media (min-width: 640px) {
		.passage-facts {
			gap: 1.5rem 2rem;
			grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
		}
	}

	.passage-fact {
		display: grid;
		gap: 0.35rem;
	}

	.passage-fact dd {
		margin: 0;
		max-width: 42rem;
		font-size: 1.05rem;
		line-height: 1.55;
		color: var(--color-text);
	}

	.passage-highlights {
		margin: 0;
		display: grid;
		gap: 0.45rem;
	}

	.passage-gallery {
		display: grid;
		gap: 1rem;
	}

	@media (min-width: 640px) {
		.passage-gallery {
			grid-template-columns: repeat(2, minmax(0, 1fr));
			gap: 1.25rem;
		}
	}
</style>
