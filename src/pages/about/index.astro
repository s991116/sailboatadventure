---
import Layout from '../../layouts/Layout.astro';
import OptimizedPhoto from '../../components/OptimizedPhoto.astro';
import Web3FormsContactForm from '../../components/Web3FormsContactForm.astro';
import { resolveLocale, t, type Locale } from '../../i18n/locale';
import { ui } from '../../i18n/messages';
import louisePhoto from '../../assets/photos/home/louise-on-deck.png';
import philipPhoto from '../../assets/photos/join-our-journey/philip_beanie.jpg';
import couplePhoto from '../../assets/photos/join-our-journey/louise-philip-sailboat.jpg';
import blueHeavenPhoto from '../../assets/photos/join-our-journey/Sailboat_cliff.jpg';

type Props = { locale?: Locale };
const locale = resolveLocale((Astro.props as Props).locale, Astro.url.pathname);
const formLabels = {
	name: t(locale, ui.form.name),
	email: t(locale, ui.form.email),
	message: t(locale, ui.form.message),
	submit: t(locale, ui.form.submit),
	success: t(locale, ui.form.success),
	error: t(locale, ui.form.error),
	sending: t(locale, ui.form.sending),
	notConfiguredBefore: t(locale, ui.form.notConfiguredBefore),
	notConfiguredAfter: t(locale, ui.form.notConfiguredAfter),
};
---

<Layout locale={locale} title={t(locale, ui.about.title)}>
	<article>
		<header>
			<h1 class="display-title">{t(locale, ui.about.title)}</h1>
			<div class="accent-rule mt-6"></div>
			<p class="lede">{t(locale, ui.about.lede)}</p>
		</header>

		<div class="page-prose mt-10 max-w-none">
			<h2>{t(locale, ui.about.coupleTitle)}</h2>
			<OptimizedPhoto
				src={couplePhoto}
				alt={t(locale, ui.about.coupleAlt)}
				preset="homeHero"
				position="50% 62%"
			/>
			{ui.about.intro.map((paragraph) => <p>{t(locale, paragraph)}</p>)}

			<h2>Philip</h2>
			<OptimizedPhoto
				src={philipPhoto}
				alt={t(locale, ui.about.philipAlt)}
				preset="homeHero"
				position="62% 40%"
			/>
			{ui.about.philip.map((paragraph) => <p>{t(locale, paragraph)}</p>)}

			<h2>Louise</h2>
			<OptimizedPhoto
				src={louisePhoto}
				alt={t(locale, ui.about.louiseAlt)}
				preset="homeHero"
			/>
			{ui.about.louise.map((paragraph) => <p>{t(locale, paragraph)}</p>)}

			<h2>{t(locale, ui.about.boatTitle)}</h2>
			<OptimizedPhoto
				src={blueHeavenPhoto}
				alt={t(locale, ui.about.boatAlt)}
				preset="homeHero"
			/>
			{ui.about.boat.map((paragraph) => <p>{t(locale, paragraph)}</p>)}

			<h2 id="contact">{t(locale, ui.about.contactTitle)}</h2>
			<p>{t(locale, ui.about.contactBody)}</p>
		</div>

		<div class="mt-10">
			<Web3FormsContactForm
				formId="about-contact"
				subject={t(locale, ui.about.contactSubject)}
				labels={formLabels}
			/>
		</div>
	</article>
</Layout>
