---
import Layout from '../../layouts/Layout.astro';
import OptimizedPhoto from '../../components/OptimizedPhoto.astro';
import { getCollection, type CollectionEntry } from 'astro:content';
import { journeyLegBySlug } from '../../data/journey-legs';

export async function getStaticPaths() {
	const legs = await getCollection('journey', ({ data }) => !data.draft);

	return legs.map((leg) => ({
		params: { slug: leg.slug },
		props: { leg },
	}));
}

type Props = {
	leg: CollectionEntry<'journey'>;
};

const { leg } = Astro.props as Props;
const { Content } = await leg.render();
const routeMeta = journeyLegBySlug[leg.slug];
const coverAlt = `${leg.data.title}: ${leg.data.routeLabel}`;
---

<Layout title={`${leg.data.title} | The Journey`}>
	<div class="journey-breakout -mt-12 sm:-mt-16">
		<OptimizedPhoto
			src={leg.data.coverImage}
			alt={coverAlt}
			preset="center"
			aspectRatio="21/9"
			class="journey-leg-hero shadow-[var(--shadow-soft)]"
		/>
	</div>

	<article class="mt-10 space-y-6 sm:mt-12">
		<header class="space-y-3">
			<p class="eyebrow">
				<a href="/journey/" class="no-underline hover:underline">The Journey</a>
				<span aria-hidden="true"> · </span>
				Leg {leg.data.legNumber}
			</p>
			<h1 class="text-5xl leading-[0.95] sm:text-6xl">{leg.data.title}</h1>
			<p class="max-w-2xl text-lg text-[color:var(--color-muted)] sm:text-xl">{leg.data.routeLabel}</p>
			{routeMeta ? (
				<span
					class="inline-block h-1 w-20 rounded-full"
					style={`background:${routeMeta.color}`}
					aria-hidden="true"
				/>
			) : null}
		</header>

		<div class="prose prose-slate max-w-none text-[color:var(--color-text)]">
			<Content />
		</div>

		<nav class="divider flex flex-wrap gap-4 pt-8 text-sm font-medium" aria-label="Journey navigation">
			{leg.data.legNumber > 1 ? (
				<a href={`/journey/togt-${leg.data.legNumber - 1}/`}>← Previous leg</a>
			) : (
				<a href="/journey/">← Back to overview</a>
			)}
			{leg.data.legNumber < 6 ? <a href={`/journey/togt-${leg.data.legNumber + 1}/`}>Next leg →</a> : null}
		</nav>
	</article>
</Layout>

<style>
	.journey-breakout {
		position: relative;
		left: 50%;
		right: 50%;
		margin-left: -50vw;
		margin-right: -50vw;
		width: 100vw;
		padding-inline: max(1.25rem, calc((100vw - 64rem) / 2 + 1.25rem));
	}

	.journey-leg-hero :global(.optimized-photo) {
		border-radius: 1rem;
	}
</style>
