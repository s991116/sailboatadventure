---
import Layout from '../../layouts/Layout.astro';
import OptimizedPhoto from '../../components/OptimizedPhoto.astro';
import Web3FormsContactForm from '../../components/Web3FormsContactForm.astro';
import {
	joinOurJourneyBenefits,
	joinOurJourneyContact,
	joinOurJourneyHero,
	joinOurJourneyImages,
	joinOurJourneyMeta,
	joinOurJourneyOpenTrips,
	joinOurJourneyWho,
} from '../../data/join-our-journey-content';

const stageOptions = joinOurJourneyOpenTrips.map((trip) => trip.formOption);
---

<Layout title={joinOurJourneyMeta.title}>
	<section class="mb-6 sm:mb-10">
		<h1 class="display-title">{joinOurJourneyHero.title}</h1>
		<div class="mt-6 sm:mt-8">
			<OptimizedPhoto
				src={joinOurJourneyImages.hero}
				alt="Louise and Philip in Egypt."
				preset="center"
				aspectRatio="16/9"
			/>
		</div>
	</section>

	<section class="mt-16 sm:mt-20" aria-labelledby="join-our-journey-benefits-title">
		<h2 id="join-our-journey-benefits-title" class="text-3xl sm:text-4xl">{joinOurJourneyBenefits.title}</h2>
		<div class="accent-rule mt-6"></div>

		<div class="mt-10 grid grid-cols-1 gap-4 sm:grid-cols-2">
			{joinOurJourneyBenefits.items.map((item) => (
				<article class="surface-card p-6 sm:p-7">
					<h3 class="text-xl font-semibold">{item.title}</h3>
					<p class="mt-3 text-[color:var(--color-muted)]">{item.description}</p>
				</article>
			))}
		</div>
	</section>

	<section class="divider mt-16 pt-16 sm:mt-20 sm:pt-20" aria-labelledby="join-our-journey-who-title">
		<h2 id="join-our-journey-who-title" class="text-3xl sm:text-4xl">{joinOurJourneyWho.title}</h2>
		<div class="accent-rule mt-6"></div>
		<p class="mt-6 max-w-2xl text-[color:var(--color-muted)]">{joinOurJourneyWho.intro}</p>

		<h3 class="mt-10 text-2xl sm:text-3xl">{joinOurJourneyWho.togetherTitle}</h3>
		<ul class="mt-6 max-w-2xl list-disc space-y-3 pl-5">
			{joinOurJourneyWho.principles.map((principle) => (
				<li>
					<strong class="font-semibold text-[color:var(--color-text)]">{principle.lead}</strong>
					<span class="text-[color:var(--color-muted)]"> {principle.text}</span>
				</li>
			))}
		</ul>

		<p class="mt-8 max-w-2xl">
			<strong class="font-semibold">{joinOurJourneyWho.sharedRule.lead}</strong>
			<span class="text-[color:var(--color-muted)]"> {joinOurJourneyWho.sharedRule.text}</span>
		</p>
	</section>

	<section class="divider mt-16 pt-16 sm:mt-20 sm:pt-20">
		<p class="max-w-2xl text-lg text-[color:var(--color-muted)] sm:text-xl">
			Read more about the routes and passages
			<a href="/plannedroute/" class="inline-flex items-center gap-2 font-medium">
				here
				<span aria-hidden="true">→</span>
			</a>
		</p>
	</section>

	<section id="contact" class="divider mt-16 pt-16 sm:mt-20 sm:pt-20" aria-labelledby="join-our-journey-contact-title">
		<div class="grid gap-10 lg:grid-cols-[1fr_1.1fr] lg:gap-12">
			<div>
				<p class="eyebrow">{joinOurJourneyContact.label}</p>
				<h2 id="join-our-journey-contact-title" class="mt-3 text-3xl sm:text-4xl">{joinOurJourneyContact.title}</h2>
				<div class="accent-rule mt-6"></div>
				<p class="mt-6 text-[color:var(--color-muted)]">{joinOurJourneyContact.intro}</p>
			</div>

			<Web3FormsContactForm
				formId="join-our-journey"
				subject="Join Our Journey enquiry — Sailboat Adventure"
				stageOptions={stageOptions}
				stageLabel={joinOurJourneyContact.form.stageLabel}
				stagePlaceholder={joinOurJourneyContact.form.stagePlaceholder}
			/>
		</div>
	</section>
</Layout>
