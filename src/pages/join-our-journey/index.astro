---
import Layout from '../../layouts/Layout.astro';
import OptimizedPhoto from '../../components/OptimizedPhoto.astro';
import ContactForm from '../../components/ContactForm.astro';
import FlagIcon from '../../components/FlagIcon.astro';
import { getOpenGuestTrips } from '../../data/planned-passages';
import { localePath, resolveLocale, t, type Locale } from '../../i18n/locale';
import { ui } from '../../i18n/messages';
import {
	joinOurJourneyBenefits,
	joinOurJourneyContact,
	joinOurJourneyHero,
	joinOurJourneyImages,
	joinOurJourneyMeta,
	joinOurJourneyWho,
} from '../../data/join-our-journey-content';

type Props = { locale?: Locale };
const locale = resolveLocale((Astro.props as Props).locale, Astro.url.pathname);
const stageOptions = getOpenGuestTrips(locale).map((trip) => trip.formOption);
const formLabels = {
	name: t(locale, ui.form.name),
	email: t(locale, ui.form.email),
	message: t(locale, ui.form.message),
	submit: t(locale, ui.form.submit),
	success: t(locale, ui.form.success),
	error: t(locale, ui.form.error),
	sending: t(locale, ui.form.sending),
};
---

<Layout locale={locale} title={t(locale, joinOurJourneyMeta.title)}>
	<section class="join-hero home-bleed" data-home-hero>
		<div class="join-hero__frame">
			<OptimizedPhoto
				src={joinOurJourneyImages.hero}
				alt={t(locale, joinOurJourneyHero.alt)}
				preset="center"
				aspectRatio="350/143"
				position="50% calc(30% - 20px)"
				plain
				sizes="100vw"
			/>
			<h1 class="home-photo-title home-photo-title--light display-title">{t(locale, joinOurJourneyHero.title)}</h1>
		</div>
	</section>
	<div class="accent-rule mt-6"></div>

	<section class="mt-16 sm:mt-20" aria-labelledby="join-our-journey-benefits-title">
		<h2 id="join-our-journey-benefits-title" class="section-title">{t(locale, joinOurJourneyBenefits.title)}</h2>
		<div class="accent-rule mt-6"></div>

		<div class="mt-10 grid grid-cols-1 gap-8 sm:grid-cols-2 sm:gap-10">
			{joinOurJourneyBenefits.items.map((item) => (
				<article>
					<h3 class="subheading">{t(locale, item.title)}</h3>
					<p class="body mt-3">{t(locale, item.description)}</p>
				</article>
			))}
		</div>

		<p class="lede mt-8">
			{t(locale, ui.join.routes)}
			<a href={localePath(locale, '/plannedroute/')} class="text-link">
				{t(locale, ui.join.here)}
				<span aria-hidden="true">→</span>
			</a>
		</p>
	</section>

	<section class="mt-16 sm:mt-20" aria-labelledby="join-our-journey-who-title">
		<h2 id="join-our-journey-who-title" class="section-title">{t(locale, joinOurJourneyWho.title)}</h2>
		<div class="accent-rule mt-6"></div>

		<ul class="body mt-10 list-disc space-y-3 pl-5">
			{joinOurJourneyWho.principles.map((principle) => (
				<li>
					<strong class="font-semibold">{t(locale, principle.lead)}</strong>
					<span> {t(locale, principle.text)}</span>
				</li>
			))}
		</ul>

		<p class="body mt-8">
			<strong class="font-semibold">{t(locale, joinOurJourneyWho.sharedRule.lead)}</strong>
			<span> {t(locale, joinOurJourneyWho.sharedRule.text)}</span>
		</p>

		<div class="mt-16 max-w-2xl sm:mt-20">
			<h2 class="section-title">{t(locale, joinOurJourneyWho.guestAgreement.label)}</h2>
			<div class="accent-rule mt-6"></div>
			<p class="lede">{t(locale, joinOurJourneyWho.guestAgreement.intro)}</p>
			<ul class="mt-5 flex flex-wrap gap-4">
				{joinOurJourneyWho.guestAgreement.downloads.map((file) => (
					<li>
						<a
							href={file.href}
							class="text-link"
							download
							aria-label={t(locale, file.ariaLabel)}
						>
							<FlagIcon code={file.flag} />
							{t(locale, file.label)}
							<span aria-hidden="true">PDF</span>
						</a>
					</li>
				))}
			</ul>
		</div>

		<div class="mt-16 max-w-2xl sm:mt-20">
			<h2 class="section-title">{t(locale, joinOurJourneyWho.safety.label)}</h2>
			<div class="accent-rule mt-6"></div>
			{joinOurJourneyWho.safety.paragraphs.map((paragraph) => (
				<p class="lede">{t(locale, paragraph)}</p>
			))}
			<p class="lede">{t(locale, joinOurJourneyWho.safety.read)}</p>
			<ul class="mt-5 flex flex-wrap gap-4">
				{joinOurJourneyWho.safety.downloads.map((file) => (
					<li>
						<a
							href={file.href}
							class="text-link"
							download
							aria-label={t(locale, file.ariaLabel)}
						>
							<FlagIcon code={file.flag} />
							{t(locale, file.label)}
							<span aria-hidden="true">PDF</span>
						</a>
					</li>
				))}
			</ul>
		</div>
	</section>

	<section id="contact" class="mt-16 sm:mt-20" aria-labelledby="join-our-journey-contact-title">
		<div class="grid gap-10 lg:grid-cols-[1fr_1.1fr] lg:gap-12">
			<div>
				<h2 id="join-our-journey-contact-title" class="section-title">{t(locale, joinOurJourneyContact.title)}</h2>
				<div class="accent-rule mt-6"></div>
				<p class="lede">{t(locale, joinOurJourneyContact.intro)}</p>
			</div>

			<ContactForm
				formId="join-our-journey"
				subject={t(locale, ui.join.subject)}
				stageOptions={stageOptions}
				stageLabel={t(locale, ui.form.stageLabel)}
				stagePlaceholder={t(locale, ui.form.stagePlaceholder)}
				labels={formLabels}
			/>
		</div>
	</section>
</Layout>

<style>
	.join-hero {
		margin-top: -3rem;
		margin-bottom: 1.5rem;
	}

	.join-hero__frame {
		position: relative;
	}

	@media (min-width: 640px) {
		.join-hero {
			margin-top: -4rem;
			margin-bottom: 2.5rem;
		}
	}
</style>
