---
import Layout from '../../layouts/Layout.astro';
import OptimizedPhoto from '../../components/OptimizedPhoto.astro';
import Web3FormsContactForm from '../../components/Web3FormsContactForm.astro';
import {
	joinOurJourneyBenefits,
	joinOurJourneyContact,
	joinOurJourneyHero,
	joinOurJourneyImages,
	joinOurJourneyMeta,
	joinOurJourneyRoute,
	joinOurJourneyWho,
} from '../../data/join-our-journey-content';

const stageOptions = joinOurJourneyRoute.stages.map(
	(s) => `${s.number} · ${s.month} — ${s.from} → ${s.to}`,
);
---

<Layout title={joinOurJourneyMeta.title}>
	<section class="mb-6 sm:mb-10">
		<OptimizedPhoto
			src={joinOurJourneyImages.hero}
			alt="Sailboat on open ocean during an Atlantic crossing, with waves and horizon beyond."
			preset="center"
			aspectRatio="16/9"
		/>
	</section>

	<section class="py-6 sm:py-10">
		<p class="eyebrow">{joinOurJourneyHero.label}</p>
		<h1 class="display-title mt-3">{joinOurJourneyHero.title}</h1>
		<div class="accent-rule mt-6"></div>
		<p class="lede">{joinOurJourneyHero.routeLine}</p>
		<div class="mt-8">
			<a href={joinOurJourneyHero.cta.href} class="inline-flex items-center gap-2 font-medium">
				{joinOurJourneyHero.cta.label}
				<span aria-hidden="true">→</span>
			</a>
		</div>
	</section>

	<section class="mt-16 sm:mt-20" aria-labelledby="join-our-journey-benefits-title">
		<OptimizedPhoto
			src={joinOurJourneyImages.benefitsBg}
			alt="Caribbean beach — destination for the final passage of the voyage."
			preset="center"
			aspectRatio="16/9"
		/>

		<div class="mt-10">
			<p class="eyebrow">{joinOurJourneyBenefits.label}</p>
			<h2 id="join-our-journey-benefits-title" class="mt-3 text-3xl sm:text-4xl">{joinOurJourneyBenefits.title}</h2>
			<div class="accent-rule mt-6"></div>

			<div class="mt-10 grid grid-cols-1 gap-4 sm:grid-cols-2">
				{joinOurJourneyBenefits.items.map((item) => (
					<article class="surface-card p-6 sm:p-7">
						<h3 class="text-xl font-semibold">{item.title}</h3>
						<p class="mt-3 text-[color:var(--color-muted)]">{item.description}</p>
					</article>
				))}
			</div>
		</div>
	</section>

	<section class="divider mt-16 pt-16 sm:mt-20 sm:pt-20" aria-labelledby="join-our-journey-who-title">
		<p class="eyebrow">{joinOurJourneyWho.label}</p>
		<h2 id="join-our-journey-who-title" class="mt-3 text-3xl sm:text-4xl">{joinOurJourneyWho.title}</h2>
		<div class="accent-rule mt-6"></div>

		<ul class="mt-10 grid gap-8 sm:grid-cols-2">
			{joinOurJourneyWho.items.map((item) => (
				<li class="flex gap-4">
					<span
						class="mt-2 h-2.5 w-2.5 shrink-0 rounded-full"
						style="background: var(--color-accent);"
						aria-hidden="true"
					></span>
					<div>
						<h3 class="text-xl font-semibold">{item.title}</h3>
						<p class="mt-2 text-[color:var(--color-muted)]">{item.description}</p>
					</div>
				</li>
			))}
		</ul>
	</section>

	<section class="divider mt-16 pt-16 sm:mt-20 sm:pt-20" aria-labelledby="join-our-journey-route-title">
		<p class="eyebrow">{joinOurJourneyRoute.label}</p>
		<h2 id="join-our-journey-route-title" class="mt-3 text-3xl sm:text-4xl">{joinOurJourneyRoute.title}</h2>
		<div class="accent-rule mt-6"></div>
		<p class="mt-6 max-w-2xl text-[color:var(--color-muted)]">{joinOurJourneyRoute.intro}</p>

		<div class="mt-10 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4">
			{joinOurJourneyRoute.stages.map((stage) => (
				<article class="surface-card p-5 sm:p-6">
					<div class="flex items-start justify-between gap-3">
						<span class="text-2xl font-semibold text-[color:var(--color-accent-strong)]">{stage.number}</span>
						<span class="eyebrow text-[0.65rem]">{stage.month}</span>
					</div>
					<div class="divider mt-4 pt-4">
						<p class="font-semibold">{stage.from}</p>
						<p class="mt-1 text-[color:var(--color-accent)]" aria-hidden="true">↓</p>
						<p class="font-semibold">{stage.to}</p>
					</div>
				</article>
			))}
		</div>

		<p class="mt-8 text-sm text-[color:var(--color-muted)]">{joinOurJourneyRoute.note}</p>
		<p class="mt-6">
			<a href={joinOurJourneyRoute.plannedRoute.href} class="inline-flex items-center gap-2 font-medium">
				{joinOurJourneyRoute.plannedRoute.label}
				<span aria-hidden="true">→</span>
			</a>
		</p>
	</section>

	<section id="contact" class="divider mt-16 pt-16 sm:mt-20 sm:pt-20" aria-labelledby="join-our-journey-contact-title">
		<div class="grid gap-10 lg:grid-cols-[1fr_1.1fr] lg:gap-12">
			<div>
				<p class="eyebrow">{joinOurJourneyContact.label}</p>
				<h2 id="join-our-journey-contact-title" class="mt-3 text-3xl sm:text-4xl">{joinOurJourneyContact.title}</h2>
				<div class="accent-rule mt-6"></div>
				<p class="mt-6 text-[color:var(--color-muted)]">{joinOurJourneyContact.intro}</p>
			</div>

			<Web3FormsContactForm
				formId="join-our-journey"
				subject="Join Our Journey enquiry — Sailboat Adventure"
				stageOptions={stageOptions}
				stageLabel={joinOurJourneyContact.form.stageLabel}
				stagePlaceholder={joinOurJourneyContact.form.stagePlaceholder}
			/>
		</div>
	</section>
</Layout>
