---
import Layout from '../../layouts/Layout.astro';
import OptimizedPhoto from '../../components/OptimizedPhoto.astro';
import Web3FormsContactForm from '../../components/Web3FormsContactForm.astro';
import {
	joinOurJourneyBenefits,
	joinOurJourneyContact,
	joinOurJourneyHero,
	joinOurJourneyImages,
	joinOurJourneyMeta,
	joinOurJourneyOpenTrips,
	joinOurJourneyWho,
} from '../../data/join-our-journey-content';

const stageOptions = joinOurJourneyOpenTrips.map((trip) => trip.formOption);
---

<Layout title={joinOurJourneyMeta.title}>
	<section class="mb-6 sm:mb-10">
		<h1 class="display-title">{joinOurJourneyHero.title}</h1>
		<div class="accent-rule mt-6"></div>
		<div class="mt-6 sm:mt-8">
			<OptimizedPhoto
				src={joinOurJourneyImages.hero}
				alt="Louise and Philip in Egypt."
				preset="center"
				aspectRatio="16/9"
			/>
		</div>
	</section>

	<section class="mt-16 sm:mt-20" aria-labelledby="join-our-journey-benefits-title">
		<h2 id="join-our-journey-benefits-title" class="section-title">{joinOurJourneyBenefits.title}</h2>
		<div class="accent-rule mt-6"></div>

		<div class="mt-10 grid grid-cols-1 gap-8 sm:grid-cols-2 sm:gap-10">
			{joinOurJourneyBenefits.items.map((item) => (
				<article>
					<h3 class="subheading">{item.title}</h3>
					<p class="body mt-3">{item.description}</p>
				</article>
			))}
		</div>

		<p class="lede mt-8">
			Read more about the routes and passages
			<a href="/plannedroute/" class="text-link">
				here
				<span aria-hidden="true">→</span>
			</a>
		</p>
	</section>

	<section class="mt-16 sm:mt-20" aria-labelledby="join-our-journey-who-title">
		<h2 id="join-our-journey-who-title" class="section-title">{joinOurJourneyWho.title}</h2>
		<div class="accent-rule mt-6"></div>

		<ul class="body mt-10 list-disc space-y-3 pl-5">
			{joinOurJourneyWho.principles.map((principle) => (
				<li>
					<strong class="font-semibold">{principle.lead}</strong>
					<span> {principle.text}</span>
				</li>
			))}
		</ul>

		<p class="body mt-8">
			<strong class="font-semibold">{joinOurJourneyWho.sharedRule.lead}</strong>
			<span> {joinOurJourneyWho.sharedRule.text}</span>
		</p>

		<div class="mt-16 max-w-2xl sm:mt-20">
			<h2 class="section-title">{joinOurJourneyWho.guestAgreement.label}</h2>
			<div class="accent-rule mt-6"></div>
			<p class="lede">{joinOurJourneyWho.guestAgreement.intro}</p>
			<ul class="mt-5 flex flex-wrap gap-4">
				{joinOurJourneyWho.guestAgreement.downloads.map((file) => (
					<li>
						<a
							href={file.href}
							class="text-link"
							download
							aria-label={file.ariaLabel}
						>
							<span
								class="inline-flex h-5 w-7 overflow-hidden rounded-sm border border-[color:var(--color-border)] shadow-sm"
								aria-hidden="true"
							>
								{file.flag === 'dk' ? (
									<svg viewBox="0 0 37 28" class="h-full w-full" xmlns="http://www.w3.org/2000/svg">
										<rect width="37" height="28" fill="#c8102e" />
										<rect x="12" width="4" height="28" fill="#fff" />
										<rect y="12" width="37" height="4" fill="#fff" />
									</svg>
								) : (
									<svg viewBox="0 0 60 30" class="h-full w-full" xmlns="http://www.w3.org/2000/svg">
										<rect width="60" height="30" fill="#012169" />
										<path d="M0 0 L60 30 M60 0 L0 30" stroke="#fff" stroke-width="6" />
										<path d="M0 0 L60 30 M60 0 L0 30" stroke="#C8102E" stroke-width="2" />
										<path d="M30 0 V30 M0 15 H60" stroke="#fff" stroke-width="10" />
										<path d="M30 0 V30 M0 15 H60" stroke="#C8102E" stroke-width="6" />
									</svg>
								)}
							</span>
							{file.label}
							<span aria-hidden="true">PDF</span>
						</a>
					</li>
				))}
			</ul>
		</div>
	</section>

	<section id="contact" class="mt-16 sm:mt-20" aria-labelledby="join-our-journey-contact-title">
		<div class="grid gap-10 lg:grid-cols-[1fr_1.1fr] lg:gap-12">
			<div>
				<h2 id="join-our-journey-contact-title" class="section-title">{joinOurJourneyContact.title}</h2>
				<div class="accent-rule mt-6"></div>
				<p class="lede">{joinOurJourneyContact.intro}</p>
			</div>

			<Web3FormsContactForm
				formId="join-our-journey"
				subject="Join Our Journey enquiry — Sailboat Adventure"
				stageOptions={stageOptions}
				stageLabel={joinOurJourneyContact.form.stageLabel}
				stagePlaceholder={joinOurJourneyContact.form.stagePlaceholder}
			/>
		</div>
	</section>
</Layout>
