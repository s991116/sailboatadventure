---
import Layout from '../../layouts/Layout.astro';
import { getCollection, type CollectionEntry } from 'astro:content';

export async function getStaticPaths() {
	const posts = await getCollection('posts', ({ data }) => !data.draft);

	return posts.map((post) => ({
		params: { slug: post.slug },
		props: { post },
	}));
}

type Props = {
	post: CollectionEntry<'posts'>;
};

const { post } = Astro.props as Props;
const { Content } = await post.render();
---

<Layout title={post.data.title}>
	<article class="space-y-6">
		<header class="space-y-2">
			<h1 class="text-4xl font-bold tracking-tight">{post.data.title}</h1>
			{post.data.description ? <p class="text-lg text-slate-300">{post.data.description}</p> : null}
			<p class="text-sm text-slate-400">
				<time datetime={post.data.pubDate.toISOString()}>
					{post.data.pubDate.toLocaleDateString('da-DK', { year: 'numeric', month: 'long', day: 'numeric' })}
				</time>
			</p>
		</header>

		<div class="prose prose-invert max-w-none">
			<Content />
		</div>
	</article>
</Layout>
