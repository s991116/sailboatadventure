---
import Layout from '../../layouts/Layout.astro';
import { getCollection, type CollectionEntry } from 'astro:content';

export async function getStaticPaths() {
	const posts = await getCollection('posts', ({ data }) => !data.draft);

	return posts.map((post) => ({
		params: { slug: post.slug },
		props: { post },
	}));
}

type Props = {
	post: CollectionEntry<'posts'>;
};

const { post } = Astro.props as Props;
const { Content } = await post.render();
---

<Layout title={post.data.title}>
	<article>
		<header>
			<h1 class="display-title">{post.data.title}</h1>
			<div class="accent-rule mt-6"></div>
			{post.data.description ? <p class="lede">{post.data.description}</p> : null}
			<p class="eyebrow mt-5">
				<time datetime={post.data.pubDate.toISOString()}>
					{post.data.pubDate.toLocaleDateString('da-DK', { year: 'numeric', month: 'long', day: 'numeric' })}
				</time>
			</p>
		</header>

		<div class="page-prose mt-10">
			<Content />
		</div>
	</article>
</Layout>
