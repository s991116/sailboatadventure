---
import Layout from '../../layouts/Layout.astro';
import { resolveLocale, t, type Locale } from '../../i18n/locale';
import { ui } from '../../i18n/messages';

type Props = { locale?: Locale };
const locale = resolveLocale((Astro.props as Props).locale, Astro.url.pathname);
---

<Layout locale={locale} title={t(locale, ui.tips.title)}>
	<article>
		<header>
			<h1 class="display-title">{t(locale, ui.tips.title)}</h1>
			<div class="accent-rule mt-6"></div>
			<p class="lede">{t(locale, ui.tips.lede)}</p>
		</header>

		<div class="page-prose mt-10 max-w-none">
			<h2>{t(locale, ui.tips.courtesyTitle)}</h2>
			<p>
				{t(locale, ui.tips.courtesyBefore)}{' '}
				<a href="https://blog.noforeignland.com/make-your-own-courtesy-flags/" target="_blank" rel="noreferrer"
					>NoForeignLand</a
				>.
			</p>
			<p>{t(locale, ui.tips.stepsIntro)}</p>
			<ol>
				{ui.tips.steps.map((step) => <li>{t(locale, step)}</li>)}
			</ol>

			<h3>{t(locale, ui.tips.makeTitle)}</h3>
			<p>
				{t(locale, ui.tips.makeBefore)}{' '}
				<a href="https://flag.sailboatadventure.dk">flag.sailboatadventure.dk</a>{' '}
				{t(locale, ui.tips.makeAfter)}
			</p>
			<h3>{t(locale, ui.tips.printTitle)}</h3>
			<p>
				{t(locale, ui.tips.printBefore)}{' '}
				<a href="https://www.pixartprinting.co.uk/" target="_blank" rel="noreferrer">PixartPrinting</a>{' '}
				{t(locale, ui.tips.printMiddle)}{' '}
				<a href="https://www.noforeignland.com/help/courtesy-flags" target="_blank" rel="noreferrer">noforeignland</a>):
			</p>
			<ul>
				{ui.tips.settings.map((item) => <li>{t(locale, item)}</li>)}
			</ul>
			<p>{t(locale, ui.tips.sheetNote)}</p>

			<h3>{t(locale, ui.tips.readTitle)}</h3>
			<ul>
				{ui.tips.read.map((item) => <li>{t(locale, item)}</li>)}
			</ul>

			<h3>{t(locale, ui.tips.sewTitle)}</h3>
			<ol>
				{ui.tips.sew.map((item) => <li>{t(locale, item)}</li>)}
			</ol>
		</div>
	</article>
</Layout>
