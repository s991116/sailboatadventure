---
import Layout from '../layouts/Layout.astro';
import OptimizedPhoto from '../components/OptimizedPhoto.astro';

type HistoryMoment = {
	id: string;
	label: string;
	title: string;
	body?: string;
	image: any;
	alt: string;
};

const historyImages = import.meta.glob('../assets/photos/history/**/*.{png,jpg,jpeg,webp,avif}', {
	eager: true,
	import: 'default',
}) as Record<string, any>;

const cleanTitle = (raw: string) => raw.replace(/^[-–—]\s*/, '').trim();

const parseFolder = (folderName: string) => {
	const match = folderName.match(/^(\d{4}-\d{2}-\d{2})\s*(.*)$/);
	if (!match) return { date: folderName, title: folderName };
	return { date: match[1], title: cleanTitle(match[2] ?? '') || match[1] };
};

const chooseCover = (paths: string[]) => {
	const sorted = [...paths].sort((a, b) => a.localeCompare(b));
	const cover = sorted.find((p) => /(^|\/)cover\./i.test(p) || /cover/i.test(p.split('/').at(-1) ?? ''));
	return cover ?? sorted[0];
};

const folderToPaths = new Map<string, string[]>();

for (const path of Object.keys(historyImages)) {
	const after = path.split('/history/')[1];
	const folder = after?.split('/')[0]?.trim();
	if (!folder) continue;
	const list = folderToPaths.get(folder) ?? [];
	list.push(path);
	folderToPaths.set(folder, list);
}

const moments: HistoryMoment[] = Array.from(folderToPaths.entries())
	.map(([folderName, paths]) => {
		const { date, title } = parseFolder(folderName);
		const coverPath = chooseCover(paths);
		return {
			id: date,
			label: date,
			title,
			image: coverPath ? historyImages[coverPath] : undefined,
			alt: `${title} (${date})`,
		} satisfies HistoryMoment;
	})
	.filter((m) => Boolean(m.image))
	.sort((a, b) => b.id.localeCompare(a.id));
---

<Layout title="History">
	<div class="history-breakout history-timeline -mt-12 sm:-mt-16" data-history-timeline>
		<div class="history-timeline__inner">
			<div class="history-track">
				<div class="history-track__line" aria-hidden="true"></div>
				<div class="history-track__progress" data-history-progress aria-hidden="true"></div>
				<div class="history-track__marker" data-history-marker aria-hidden="true"></div>

				<div class="history-track__ticks" role="navigation" aria-label="Jump in the timeline">
					{moments.map((moment, index) => (
						<button
							type="button"
							class="history-tick"
							data-history-tick
							data-history-index={index}
							aria-label={moment.label}
						>
							<span class="history-tick__dot" aria-hidden="true"></span>
							<span class="history-tick__label" aria-hidden="true">{moment.id.slice(0, 4)}</span>
						</button>
					))}
				</div>
			</div>
		</div>
	</div>

	<section class="mt-10 space-y-4 sm:mt-12">
		<p class="eyebrow">Timeline</p>
		<h1 class="text-5xl leading-[0.95] sm:text-6xl">Back through the logbook</h1>
		<p class="max-w-2xl text-lg text-[color:var(--color-muted)] sm:text-xl">
			Scroll down to move back in time. Each moment grows as it nears the middle of the screen, then fades away as it
			leaves.
		</p>
	</section>

	<div class="mt-10 sm:mt-14">
		<div class="space-y-14 sm:space-y-20">
			{moments.map((moment) => (
				<section class="history-item" data-history-item data-history-id={moment.id} aria-label={moment.label}>
					<div class="grid gap-8 sm:gap-10 md:grid-cols-2 md:items-center">
						<div class="history-item__media" data-history-media>
							<OptimizedPhoto
								src={moment.image}
								alt={moment.alt}
								aspectRatio="4/5"
								preset="center"
								class="shadow-[var(--shadow-soft)]"
							/>
						</div>
						<div class="history-item__content surface-card p-7 sm:p-9" data-history-content>
							<p class="eyebrow">{moment.label}</p>
							<h2 class="mt-3 text-3xl sm:text-4xl">{moment.title}</h2>
							<div class="accent-rule mt-6"></div>
							{moment.body ? <p class="mt-6 text-[color:var(--color-muted)]">{moment.body}</p> : null}
						</div>
					</div>
				</section>
			))}
		</div>
	</div>

	<script is:inline>
		(() => {
			const reduceMotion = window.matchMedia?.('(prefers-reduced-motion: reduce)')?.matches ?? false;

			const scroller = document.scrollingElement ?? document.documentElement;
			const getScrollTop = () => {
				try {
					return typeof scroller?.scrollTop === 'number'
						? scroller.scrollTop
						: window.scrollY || window.pageYOffset || 0;
				} catch (_) {
					return window.scrollY || window.pageYOffset || 0;
				}
			};

			const scrollToTop = (top) => {
				if (scroller === document.documentElement || scroller === document.body) {
					window.scrollTo({ top, behavior: reduceMotion ? 'auto' : 'smooth' });
					return;
				}

				if (scroller && typeof scroller.scrollTo === 'function') {
					scroller.scrollTo({ top, behavior: reduceMotion ? 'auto' : 'smooth' });
					return;
				}

				window.scrollTo({ top, behavior: reduceMotion ? 'auto' : 'smooth' });
			};

			const headerEl = document.querySelector('.site-header');
			const setHeaderHeightVar = () => {
				const headerHeight = headerEl instanceof HTMLElement ? headerEl.offsetHeight : 0;
				document.documentElement.style.setProperty('--site-header-h', `${headerHeight}px`);
			};
			setHeaderHeightVar();

			const timelineEl = document.querySelector('[data-history-timeline]');
			const markerEl = document.querySelector('[data-history-marker]');
			const progressEl = document.querySelector('[data-history-progress]');
			const tickEls = Array.from(document.querySelectorAll('[data-history-tick]'));

			const itemEls = Array.from(document.querySelectorAll('[data-history-item]'));
			const items = itemEls
				.map((el) => {
					const media = el.querySelector('[data-history-media]');
					const content = el.querySelector('[data-history-content]');
					return { el, media, content };
				})
				.filter((item) => item.el instanceof HTMLElement) as Array<{
				el: HTMLElement;
				media: Element | null;
				content: Element | null;
			}>;

			let centers: number[] = [];
			const clamp = (n, min, max) => Math.min(max, Math.max(min, n));

			const recalc = () => {
				setHeaderHeightVar();
				const scrollTop = getScrollTop();
				centers = items.map(({ el }) => {
					const rect = el.getBoundingClientRect();
					return scrollTop + rect.top + rect.height / 2;
				});
			};

			const scrollToIndex = (index) => {
				const vh = window.innerHeight || 1;
				const targetCenter = centers[index] ?? 0;
				const top = Math.max(0, Math.round(targetCenter - vh / 2));
				scrollToTop(top);
			};

			for (const tick of tickEls) {
				tick.addEventListener('click', () => {
					const raw = tick.getAttribute('data-history-index');
					const index = raw ? Number.parseInt(raw, 10) : 0;
					scrollToIndex(Number.isFinite(index) ? index : 0);
				});
			}

			let raf = 0;
			const update = () => {
				raf = 0;
				if (!items.length) return;

				const vh = window.innerHeight || 1;
				const viewportCenter = vh / 2;
				const scrollTop = getScrollTop();
				const scrollCenter = scrollTop + viewportCenter;

				let activeIndex = 0;
				let minDist = Infinity;

				for (let i = 0; i < items.length; i++) {
					const { el } = items[i];
					const rect = el.getBoundingClientRect();
					const elCenter = rect.top + rect.height / 2;
					const dist = Math.abs(elCenter - viewportCenter);
					const t = clamp(dist / (vh * 0.65), 0, 1);
					const p = reduceMotion ? 1 : 1 - t;

					el.style.setProperty('--p', p.toFixed(4));

					const docCenter = centers[i] ?? (scrollTop + elCenter);
					const docDist = Math.abs(docCenter - scrollCenter);
					if (docDist < minDist) {
						minDist = docDist;
						activeIndex = i;
					}
				}

				const start = centers[0] ?? 0;
				const end = centers[centers.length - 1] ?? start + 1;
				const progress = clamp((scrollCenter - start) / (end - start || 1), 0, 1);

				if (markerEl instanceof HTMLElement) markerEl.style.setProperty('--x', `${(progress * 100).toFixed(3)}%`);
				if (progressEl instanceof HTMLElement) progressEl.style.width = `${(progress * 100).toFixed(3)}%`;

				const activeTick = tickEls[activeIndex];
				for (const tick of tickEls) tick.toggleAttribute('data-active', tick === activeTick);

				timelineEl?.classList.toggle('is-ready', true);
			};

			const requestUpdate = () => {
				if (raf) return;
				raf = window.requestAnimationFrame(update);
			};

			recalc();
			requestUpdate();

			window.addEventListener('scroll', requestUpdate, { passive: true });
			if (scroller && scroller !== document.documentElement) {
				scroller.addEventListener('scroll', requestUpdate, { passive: true });
			}

			window.addEventListener('resize', () => {
				recalc();
				requestUpdate();
			});
			window.addEventListener('load', () => {
				recalc();
				requestUpdate();
			});

			const ro = typeof ResizeObserver !== 'undefined' ? new ResizeObserver(() => {
				recalc();
				requestUpdate();
			}) : null;
			if (ro) {
				for (const { el } of items) ro.observe(el);
			}
		})();
	</script>

	<style>
		:root {
			--history-red: #d11a2a;
		}

		.history-breakout {
			position: relative;
			left: 50%;
			right: 50%;
			margin-left: -50vw;
			margin-right: -50vw;
			width: 100vw;
		}

		.history-timeline {
			position: sticky;
			top: var(--site-header-h, 64px);
			z-index: 40;
			backdrop-filter: blur(10px);
			background: rgba(251, 247, 239, 0.8);
			border-bottom: 1px solid var(--color-border);
		}

		.history-timeline__inner {
			width: 100%;
			padding: 10px 0 6px;
		}

		.history-track {
			min-width: 0;
			width: 100%;
			position: relative;
			padding: 18px 0 14px;
		}

		.history-track__line {
			position: absolute;
			inset: 24px 0 auto;
			height: 2px;
			background: rgba(20, 20, 20, 0.12);
			border-radius: 999px;
			z-index: 1;
		}

		.history-track__progress {
			position: absolute;
			inset: 24px 0 auto;
			height: 2px;
			width: 0%;
			background: linear-gradient(90deg, var(--history-red), rgba(209, 26, 42, 0.45));
			border-radius: 999px;
			z-index: 2;
		}

		.history-track__marker {
			position: absolute;
			top: 24px;
			left: var(--x, 0%);
			width: 22px;
			height: 22px;
			transform: translate(-50%, -50%);
			border-radius: 999px;
			background: rgba(251, 247, 239, 0.95);
			border: 2px solid var(--history-red);
			box-shadow: 0 12px 20px rgba(20, 20, 20, 0.14);
			z-index: 4;
		}

		.history-track__marker::after {
			content: "";
			position: absolute;
			inset: 50% auto auto 50%;
			width: 8px;
			height: 8px;
			transform: translate(-50%, -50%);
			border-radius: 999px;
			background: var(--history-red);
		}

		.history-track__ticks {
			display: flex;
			align-items: center;
			justify-content: space-between;
			gap: 0;
			position: relative;
			z-index: 3;
		}

		.history-tick {
			appearance: none;
			border: 0;
			background: transparent;
			padding: 12px 10px;
			display: grid;
			justify-items: center;
			gap: 0;
			cursor: pointer;
			color: var(--color-muted);
			touch-action: manipulation;
		}

		.history-tick__label {
			margin-top: 6px;
			font-size: 11px;
			line-height: 1;
			letter-spacing: 0.06em;
		}

		@media (max-width: 520px) {
			.history-tick__label {
				display: none;
			}
		}

		.history-tick:focus-visible {
			outline: 2px solid rgba(184, 132, 58, 0.55);
			outline-offset: 6px;
			border-radius: 999px;
		}

		.history-tick__dot {
			width: 12px;
			height: 12px;
			border-radius: 999px;
			background: rgba(20, 20, 20, 0.45);
			border: 1px solid rgba(251, 247, 239, 0.95);
			box-shadow: 0 0 0 4px rgba(209, 26, 42, 0);
			transition: transform 180ms ease, box-shadow 180ms ease, background 180ms ease;
		}

		.history-tick[data-active] {
			color: var(--color-text);
		}

		.history-tick[data-active] .history-tick__dot {
			background: var(--history-red);
			box-shadow: 0 0 0 4px rgba(209, 26, 42, 0.18);
			transform: scale(1.05);
		}

		.history-item {
			--p: 1;
			min-height: min(92vh, 980px);
			display: grid;
			align-items: center;
		}

		.history-item__media,
		.history-item__content {
			will-change: transform, filter, opacity;
			transform: translate3d(0, calc((1 - var(--p)) * 18px), 0)
				scale(calc(0.9 + var(--p) * 0.16));
			opacity: calc(0.22 + var(--p) * 0.78);
			filter: blur(calc((1 - var(--p)) * 6px));
			transition: opacity 120ms linear;
		}

		.history-item__content {
			transform: translate3d(0, calc((1 - var(--p)) * 10px), 0)
				scale(calc(0.94 + var(--p) * 0.1));
			filter: blur(calc((1 - var(--p)) * 5px));
		}

		@media (prefers-reduced-motion: reduce) {
			.history-item__media,
			.history-item__content {
				transform: none !important;
				filter: none !important;
				opacity: 1 !important;
				transition: none !important;
			}
		}
	</style>
</Layout>
